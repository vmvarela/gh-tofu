+package command
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	orasstate "github.com/vmvarela/oras-state"
+
+	backendORAS "github.com/opentofu/opentofu/internal/backend/remote-state/oras"
+	"github.com/opentofu/opentofu/internal/command/arguments"
+)
+
+func TestOrasCopyRequiresDestination(t *testing.T) {
+	if code := (OrasCopyCommand{}).Execute(&arguments.OrasCopy{}); code != 1 {
+		t.Fatalf("exit code = %d, want 1", code)
+	}
+}
+
+func TestCheckCopyPlanRefusesEmpty(t *testing.T) {
+	if err := checkCopyPlan(&orasstate.CopyPlan{}); err == nil {
+		t.Fatal("empty plan was accepted")
+	}
+	if err := checkCopyPlan(&orasstate.CopyPlan{
+		Artifacts: []orasstate.CopyArtifact{{Tag: "state-default"}},
+		Skipped:   []string{"unlocked-default"},
+	}); err != nil {
+		t.Fatalf("plan with artifacts was refused: %s", err)
+	}
+}
+
+func TestWriteCompactOutput(t *testing.T) {
+	stateCopy := &backendORAS.StateCopy{
+		SourceRepository:      "ghcr.io/acme/state",
+		DestinationRepository: "ghcr.io/acme/state-next",
+	}
+	plan := &orasstate.CopyPlan{
+		Artifacts: []orasstate.CopyArtifact{{Tag: "state-default"}, {Tag: "stver-default-v1"}, {Tag: "custom-artifact"}},
+		Skipped:   []string{"unlocked-default"},
+	}
+	report := &orasstate.CopyReport{
+		Copied:   []orasstate.CopyArtifact{{Tag: "state-default"}, {Tag: "stver-default-v1"}},
+		Existing: []orasstate.CopyArtifact{{Tag: "custom-artifact"}},
+		Verified: []orasstate.CopyArtifact{{Tag: "state-default"}, {Tag: "stver-default-v1"}, {Tag: "custom-artifact"}},
+	}
+
+	var out bytes.Buffer
+	writeCopyPlan(&out, stateCopy, plan)
+	writeCopyReport(&out, stateCopy, report)
+	got := out.String()
+
+	for _, want := range []string{
+		"Source:      ghcr.io/acme/state",
+		"Destination: ghcr.io/acme/state-next",
+		"Plan: 3 artifact(s) to copy, 1 skipped.",
+		"unlocked-default",
+		"Copy: 2 copied, 1 already present, 3 verified.",
+		"Source retained",
+		"Untagged GHCR package versions",
+		"ghcr.io/acme/state-next",
+		"gh tofu init -reconfigure",
+		"-migrate-state",
+	} {
+		if !strings.Contains(got, want) {
+			t.Fatalf("output missing %q:\n%s", want, got)
+		}
+	}
+}
+
+func TestWriteCopyReportSkipsUntaggedNoteOffGHCR(t *testing.T) {
+	stateCopy := &backendORAS.StateCopy{
+		SourceRepository:      "registry.example.com:5000/acme/state",
+		DestinationRepository: "registry.example.com:5000/acme/state-next",
+	}
+	var out bytes.Buffer
+	writeCopyReport(&out, stateCopy, &orasstate.CopyReport{})
+	if strings.Contains(out.String(), "Untagged GHCR") {
+		t.Fatalf("GHCR note printed for a non-GHCR source:\n%s", out.String())
+	}
+}
