+package command
+
+import (
+	"strings"
+
+	"github.com/mitchellh/cli"
+)
+
+func OrasCommander() Command {
+	cmd := Command{
+		Name:  "oras",
+		Short: "Manage state stored in an OCI registry",
+		Long: `This command has subcommands that work on the OCI registry repository
+that holds state published by the oras backend.
+
+They operate on the artifacts in the registry rather than on the saved state,
+and they are meant to be used together with the oras backend configuration.`,
+
+		Commands: []Command{
+			OrasCopyCommander(),
+		},
+	}
+
+	return cmd
+}
+
+// OrasCommand is a Command implementation that just shows help for
+// the subcommands nested below it.
+type OrasCommand struct{}
+
+func (c *OrasCommand) Run(_ []string) int {
+	return cli.RunResultHelp
+}
+
+func (c *OrasCommand) Help() string {
+	helpText := `
+Usage: tofu [global options] oras <subcommand> [options] [args]
+
+  This command has subcommands that work on the OCI registry repository
+  that holds state published by the oras backend.
+
+  They operate on the artifacts in the registry rather than on the saved
+  state.
+`
+	return strings.TrimSpace(helpText)
+}
+
+func (c *OrasCommand) Synopsis() string {
+	return "Manage state stored in an OCI registry"
+}
diff --git a/internal/command/oras_copy.go b/internal/command/oras_copy.go
new file mode 100644
index 000000000..7aca9236b
--- /dev/null
+++ b/internal/command/oras_copy.go
@@ -0,0 +1,183 @@
+package command
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	orasstate "github.com/vmvarela/oras-state"
+
+	backendORAS "github.com/opentofu/opentofu/internal/backend/remote-state/oras"
+	"github.com/opentofu/opentofu/internal/command/arguments"
+)
+
+// stateCopyBackend is implemented by the ORAS backend, which validates the
+// destination and builds the two clients for a repository-to-repository copy.
+type stateCopyBackend interface {
+	StateCopy(context.Context, string) (*backendORAS.StateCopy, error)
+}
+
+const orasCopyLong = `Copy every tagged state artifact from the configured repository to a new
+repository, verify both sides, and keep the source unchanged.
+
+The destination is a literal registry/repository without a tag or digest. It
+must be on the same registry as the configured source; for ghcr.io it must also
+stay in the same owner.
+
+Stop every process that writes the source state repository and put it in
+maintenance before planning. Keep all of them stopped until the copy and its
+verification finish. A concurrent change is detected by re-inventory, but that
+detection is not compare-and-swap: it cannot guarantee a consistent snapshot and
+can leave a partial destination or fail verification.
+
+Only validated unlock markers are skipped, including GHCR's locked- aliases.
+Active, expired, or malformed lock artifacts block the copy; tag names alone
+do not prove that a lock is released.
+
+This command is a dry run by default. It never deletes the source, changes
+configuration, the saved backend, or plan files, and it does not require
+deletion credentials. After it succeeds, edit the backend "repository" literal
+and run "gh tofu init -reconfigure".`
+
+func OrasCopyCommander() Command {
+	cmd := Command{
+		Name:  "copy",
+		Short: "Copy state artifacts to a new repository",
+		Long:  orasCopyLong,
+		UsageOverride: UsageOverride{
+			Usage: "tofu [global options] oras copy [options] <destination>",
+		},
+	}
+
+	args := arguments.BindOrasCopy(&cmd.CommandLine)
+	cmd.Run = func(meta Meta) int {
+		return OrasCopyCommand{StateMeta{meta}}.Execute(args)
+	}
+
+	return cmd
+}
+
+// OrasCopyCommand is a Command implementation for 'oras copy'.
+type OrasCopyCommand struct {
+	StateMeta
+}
+
+func (c *OrasCopyCommand) Run(rawArgs []string) int {
+	return RunCommand(OrasCopyCommander(), c.Meta, rawArgs)
+}
+
+func (c OrasCopyCommand) Execute(args *arguments.OrasCopy) int {
+	if strings.TrimSpace(args.Destination) == "" {
+		return orasCopyError(fmt.Errorf("oras copy requires a destination repository in the form <registry>/<repository>"))
+	}
+
+	ctx := c.CommandContext()
+	if diags := c.Meta.checkRequiredVersion(ctx); diags.HasErrors() {
+		return orasCopyError(diags.Err())
+	}
+
+	enc, diags := c.Encryption(ctx)
+	if diags.HasErrors() {
+		return orasCopyError(diags.Err())
+	}
+
+	b, diags := c.Backend(ctx, nil, enc.State())
+	if diags.HasErrors() {
+		return orasCopyError(diags.Err())
+	}
+	// The copy reads the source and writes only to the destination.
+	c.ignoreRemoteVersionConflict(b)
+
+	copyBackend, ok := b.(stateCopyBackend)
+	if !ok {
+		return orasCopyError(fmt.Errorf("the active backend does not support oras copy; configure the oras backend"))
+	}
+
+	stateCopy, err := copyBackend.StateCopy(ctx, args.Destination)
+	if err != nil {
+		return orasCopyError(err)
+	}
+
+	plan, err := stateCopy.Source.PlanCopy(ctx)
+	if err != nil {
+		return orasCopyError(fmt.Errorf("planning copy: %w", err))
+	}
+	if err := checkCopyPlan(plan); err != nil {
+		return orasCopyError(err)
+	}
+	writeCopyPlan(os.Stdout, stateCopy, plan)
+
+	if !args.Apply {
+		fmt.Fprintln(os.Stdout, "\nDry run: nothing was written. Re-run with -apply to copy and verify.")
+		return 0
+	}
+
+	report, err := stateCopy.Source.CopyTo(ctx, stateCopy.Destination, plan)
+	if err != nil {
+		if report != nil {
+			fmt.Fprintf(os.Stdout, "\nCopy stopped after %d copied, %d already present, %d verified.\n",
+				len(report.Copied), len(report.Existing), len(report.Verified))
+		}
+		return orasCopyError(fmt.Errorf("copying state: %w", err))
+	}
+	writeCopyReport(os.Stdout, stateCopy, report)
+	return 0
+}
+
+func (c *OrasCopyCommand) Help() string {
+	return "Usage: tofu [global options] oras copy [options] <destination>\n\n" + orasCopyLong + `
+
+Options:
+
+  -apply    Copy and verify the planned artifacts.`
+}
+
+func (c *OrasCopyCommand) Synopsis() string {
+	return "Copy state artifacts to a new repository"
+}
+
+func checkCopyPlan(plan *orasstate.CopyPlan) error {
+	if plan == nil || len(plan.Artifacts) == 0 {
+		return fmt.Errorf("the source repository has no tagged state artifacts to copy; refusing to point the backend at an empty destination")
+	}
+	return nil
+}
+
+func writeCopyPlan(w io.Writer, stateCopy *backendORAS.StateCopy, plan *orasstate.CopyPlan) {
+	fmt.Fprintf(w, "Source:      %s\n", stateCopy.SourceRepository)
+	fmt.Fprintf(w, "Destination: %s\n\n", stateCopy.DestinationRepository)
+	fmt.Fprintf(w, "Plan: %d artifact(s) to copy, %d skipped.\n", len(plan.Artifacts), len(plan.Skipped))
+	if len(plan.Skipped) > 0 {
+		fmt.Fprintf(w, "Skipped tags: %s\n", strings.Join(plan.Skipped, ", "))
+	}
+	if isGHCRRepository(stateCopy.DestinationRepository) {
+		fmt.Fprintln(w, "OCI tags cannot reveal untagged versions already in the destination package; use a new package for a clean target.")
+	}
+}
+
+func writeCopyReport(w io.Writer, stateCopy *backendORAS.StateCopy, report *orasstate.CopyReport) {
+	fmt.Fprintf(w, "\nCopy: %d copied, %d already present, %d verified.\n",
+		len(report.Copied), len(report.Existing), len(report.Verified))
+	fmt.Fprintln(w, "Source retained: no source artifact or package version was deleted, and no deletion credentials were used.")
+	if isGHCRRepository(stateCopy.SourceRepository) {
+		fmt.Fprintln(w, "\nUntagged GHCR package versions cannot be detected through OCI tags. Any")
+		fmt.Fprintln(w, "untagged versions in the source package are neither listed nor copied.")
+	}
+	fmt.Fprintf(w, "\nNext steps:\n")
+	fmt.Fprintf(w, "  1. Edit the backend \"repository\" literal in your configuration to:\n       %s\n", stateCopy.DestinationRepository)
+	fmt.Fprintf(w, "  2. Run: gh tofu init -reconfigure\n")
+	fmt.Fprintf(w, "  3. Confirm the destination works (for example gh tofu plan) before moving\n")
+	fmt.Fprintf(w, "     other writers. Do not use -migrate-state for this copy.\n")
+}
+
+func isGHCRRepository(repository string) bool {
+	registry, _, _ := strings.Cut(repository, "/")
+	return strings.EqualFold(registry, "ghcr.io")
+}
+
+func orasCopyError(err error) int {
+	fmt.Fprintf(os.Stderr, "Error: %s\n", err)
+	return 1
+}
