new file mode 100644
index 000000000..19b7014a6
--- /dev/null
+++ b/internal/backend/remote-state/oras/state_copy.go
@@ -0,0 +1,74 @@
+package oras
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	orasstate "github.com/vmvarela/oras-state"
+)
+
+// StateCopy is a validated copy between the configured source repository and a
+// destination repository. Destination credentials are resolved for the
+// destination path; transport, TLS and retry policy match the source.
+type StateCopy struct {
+	SourceRepository      string
+	DestinationRepository string
+	Source                *orasstate.Client
+	Destination           *orasstate.Client
+}
+
+// StateCopy validates destination and builds both clients. The source client is
+// the configured backend client; the destination client is read-only until the
+// caller runs CopyTo.
+func (b *Backend) StateCopy(ctx context.Context, destination string) (*StateCopy, error) {
+	if err := validateCopyDestination(b.repository, destination); err != nil {
+		return nil, err
+	}
+	if b.client == nil {
+		return nil, fmt.Errorf("backend is not configured")
+	}
+
+	dst, err := b.newClient(ctx, destination)
+	if err != nil {
+		return nil, fmt.Errorf("configuring destination repository %s: %w", destination, err)
+	}
+	return &StateCopy{
+		SourceRepository:      b.repository,
+		DestinationRepository: destination,
+		Source:                b.client,
+		Destination:           dst,
+	}, nil
+}
+
+// validateCopyDestination accepts a literal registry/repository on the same
+// registry as the source. GHCR copies must stay in the source owner, because a
+// destination under another owner would need different package access.
+func validateCopyDestination(source, destination string) error {
+	src, err := parseRepository(source)
+	if err != nil {
+		return fmt.Errorf("source repository %q: %w", source, err)
+	}
+	dst, err := parseRepository(destination)
+	if err != nil {
+		return fmt.Errorf("destination %q: %w", destination, err)
+	}
+	if strings.EqualFold(src.Registry, dst.Registry) && strings.EqualFold(src.Repository, dst.Repository) {
+		return fmt.Errorf("destination must differ from the source repository %s", source)
+	}
+	if !strings.EqualFold(src.Registry, dst.Registry) {
+		return fmt.Errorf("destination %s is on a different registry; state can only be copied within %s", dst.Registry, src.Registry)
+	}
+	if strings.EqualFold(src.Registry, ghcrRegistry) {
+		srcOwner, dstOwner := ghcrOwner(src.Repository), ghcrOwner(dst.Repository)
+		if !strings.EqualFold(srcOwner, dstOwner) {
+			return fmt.Errorf("destination %s must stay in the same %s owner as the source (%s); cross-owner copies are not supported", dst.Repository, ghcrRegistry, srcOwner)
+		}
+	}
+	return nil
+}
+
+func ghcrOwner(repository string) string {
+	owner, _, _ := strings.Cut(repository, "/")
+	return owner
+}
diff --git a/internal/backend/remote-state/oras/state_copy_test.go b/internal/backend/remote-state/oras/state_copy_test.go
