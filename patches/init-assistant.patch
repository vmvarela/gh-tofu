+func TestMaybeSetupORASBackendSkipsShadowedTfFile(t *testing.T) {
+	dir := t.TempDir()
+	writeTestFile(t, filepath.Join(dir, "main.tf"), "terraform {}\n")
+	// The parser ignores backend.tf when backend.tofu exists.
+	writeTestFile(t, filepath.Join(dir, "backend.tofu"), "terraform {}\n")
+	t.Chdir(dir)
+
+	view, done := testView(t)
+	defer done(t)
+	cleanup := testInputMap(t, map[string]string{
+		"oras-backend-setup":      "yes",
+		"oras-backend-repository": "ghcr.io/org/state",
+	})
+	defer cleanup()
+
+	c := &InitCommand{Meta: Meta{WorkingDir: workdir.NewDir("."), View: view}}
+	path, diags := c.maybeSetupORASBackend(context.Background(), ".", &configs.Module{})
+	if path != "backend.gh-tofu.tf" || diags.HasErrors() {
+		t.Fatalf("setup returned path %q and diagnostics %s", path, diags.Err())
+	}
+	if _, err := os.Stat(filepath.Join(dir, "backend.tf")); !os.IsNotExist(err) {
+		t.Fatalf("shadowed backend.tf was created: %v", err)
+	}
+
+	mod, loadDiags := c.loadSingleModuleWithTests(context.Background(), ".", "tests")
+	if loadDiags.HasErrors() {
+		t.Fatalf("generated config did not load: %s", loadDiags.Err())
+	}
+	if mod.Backend == nil || mod.Backend.Type != "oras" {
+		t.Fatalf("generated config was not parsed as the oras backend: %#v", mod.Backend)
+	}
+}
