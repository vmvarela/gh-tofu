@@ -0,0 +1,32 @@
+// Copyright (c) The OpenTofu Authors
+// SPDX-License-Identifier: MPL-2.0
+
+package arguments
+
+import (
+	"github.com/opentofu/opentofu/internal/tfdiags"
+)
+
+// OrasPurge represents the command-line arguments for the 'oras purge' command.
+type OrasPurge struct {
+	// Apply deletes the reported package versions instead of only listing them.
+	Apply bool
+}
+
+// BindOrasPurge registers the CLI arguments for 'oras purge'.
+func BindOrasPurge(cli *CommandLine) *OrasPurge {
+	ret := &OrasPurge{}
+	cli.BoolVar(&ret.Apply, "apply", false, "Delete the reported package versions instead of only listing them.")
+	return ret
+}
+
+// ParseOrasPurge processes CLI arguments, returning an OrasPurge value, a
+// closer function, and errors. If errors are encountered, an OrasPurge value
+// is still returned representing the best effort interpretation of the
+// arguments.
+func ParseOrasPurge(args []string) (*OrasPurge, func(), tfdiags.Diagnostics) {
+	cli := new(CommandLine)
+	ret := BindOrasPurge(cli)
+	closer, diags := cli.parseWithHooks("oras purge", args)
+	return ret, closer, diags
+}
diff --git a/internal/command/arguments/oras_purge_test.go b/internal/command/arguments/oras_purge_test.go
