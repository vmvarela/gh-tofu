index 000000000..34e8acc9d
--- /dev/null
+++ b/internal/command/arguments/oras_purge_test.go
@@ -0,0 +1,29 @@
+// Copyright (c) The OpenTofu Authors
+// SPDX-License-Identifier: MPL-2.0
+
+package arguments
+
+import "testing"
+
+func TestParseOrasPurge(t *testing.T) {
+	testCases := map[string]struct {
+		args []string
+		want bool
+	}{
+		"dry run by default": {args: nil, want: false},
+		"apply":              {args: []string{"-apply"}, want: true},
+	}
+
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			args, closer, diags := ParseOrasPurge(tc.args)
+			defer closer()
+			if diags.HasErrors() {
+				t.Fatalf("unexpected errors: %s", diags.Err())
+			}
+			if args.Apply != tc.want {
+				t.Fatalf("Apply = %v, want %v", args.Apply, tc.want)
+			}
+		})
+	}
+}
