@@ -0,0 +1,48 @@
+// Copyright (c) The OpenTofu Authors
+// SPDX-License-Identifier: MPL-2.0
+
+package views
+
+import (
+	"fmt"
+
+	orasstate "github.com/vmvarela/oras-state"
+)
+
+// Oras is the view for the "tofu oras" command family.
+type Oras struct {
+	view *View
+}
+
+func NewOras(view *View) *Oras {
+	return &Oras{view: view}
+}
+
+// PurgeReport prints the outcome of a purge run.
+func (v *Oras) PurgeReport(report orasstate.PurgeReport, apply bool) {
+	if !apply {
+		v.view.streams.Println("Dry run: nothing was deleted. Re-run with -apply to delete the versions listed below.")
+	}
+
+	for _, candidate := range report.Candidates {
+		v.view.streams.Printf("  version %d  %s  (%s)\n", candidate.VersionID, candidate.Digest, candidate.Reason)
+	}
+
+	if apply {
+		for _, deleted := range report.Deleted {
+			v.view.streams.Printf("deleted version %d  %s\n", deleted.VersionID, deleted.Digest)
+		}
+	}
+
+	for _, line := range report.Skipped {
+		v.view.streams.Printf("skipped: %s\n", line)
+	}
+
+	action := "candidates"
+	count := len(report.Candidates)
+	if apply {
+		action = "deleted"
+		count = len(report.Deleted)
+	}
+	v.view.streams.Println(fmt.Sprintf("%d %s, %d tagged versions kept.", count, action, report.KeptTagged))
+}
