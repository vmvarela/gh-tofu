+// Copyright (c) The OpenTofu Authors
+// SPDX-License-Identifier: MPL-2.0
+
+package command
+
+import (
+	"strings"
+
+	"github.com/mitchellh/cli"
+)
+
+// OrasCommander returns the "tofu oras" command group.
+func OrasCommander() Command {
+	cmd := Command{
+		Name:  "oras",
+		Short: "Manage state stored in an OCI registry",
+		Long: `Groups the commands that work on the OCI registry used by the oras
+backend.
+
+These commands talk to the registry directly, not through the state manager,
+so they never read or decrypt the state payload itself.`,
+		Commands: []Command{
+			OrasPurgeCommander(),
+		},
+	}
+
+	return cmd
+}
+
+// OrasCommand is the entry point of the "tofu oras" command group.
+type OrasCommand struct{}
+
+func (c *OrasCommand) Run(_ []string) int {
+	return cli.RunResultHelp
+}
+
+func (c *OrasCommand) Help() string {
+	helpText := `
+Usage: tofu [global options] oras <subcommand> [options] [args]
+
+  Manage state stored in an OCI registry.
+
+  This command has subcommands for working on the registry used by the oras
+  backend. Run "tofu oras <subcommand> -help" for details on a subcommand.
+
+Subcommands:
+
+  purge    Delete unused package versions from a GHCR repository.
+`
+	return strings.TrimSpace(helpText)
+}
+
+func (c *OrasCommand) Synopsis() string {
+	return "Manage state stored in an OCI registry"
+}
diff --git a/internal/command/oras_purge.go b/internal/command/oras_purge.go
new file mode 100644
index 000000000..d01ba2744
--- /dev/null
+++ b/internal/command/oras_purge.go
@@ -0,0 +1,125 @@
+// Copyright (c) The OpenTofu Authors
+// SPDX-License-Identifier: MPL-2.0
+
+package command
+
+import (
+	"context"
+	"strings"
+
+	backendLocal "github.com/opentofu/opentofu/internal/backend/local"
+	"github.com/opentofu/opentofu/internal/command/arguments"
+	"github.com/opentofu/opentofu/internal/command/views"
+	"github.com/opentofu/opentofu/internal/encryption"
+	"github.com/opentofu/opentofu/internal/tfdiags"
+
+	orasstate "github.com/vmvarela/oras-state"
+)
+
+// orasPurgeBackend is the part of the oras backend that this command needs.
+type orasPurgeBackend interface {
+	Purge(ctx context.Context, opts orasstate.PurgeOptions) (orasstate.PurgeReport, error)
+}
+
+func OrasPurgeCommander() Command {
+	cmd := Command{
+		Name:  "purge",
+		Short: "Delete unused package versions from the configured GHCR repository",
+		Long: `Delete package versions that no live tag references, plus history beyond
+the configured max_versions, from the OCI repository used by the "oras" backend.
+
+ghcr.io rejects manifest deletion through the registry API, so this command uses
+the GitHub Packages API instead. It needs a token with the delete:packages scope
+and admin access to the package, which a normal plan or apply token does not have.
+
+It is a dry run unless -apply is given. It never deletes the last tagged version,
+refuses to run while a workspace lock is live, re-reads the live tag set before
+deleting, and verifies the surviving state after deleting.`,
+		DiagsWithNewline: true,
+	}
+
+	args := arguments.BindOrasPurge(&cmd.CommandLine)
+	cmd.Run = func(meta Meta) int {
+		return OrasPurgeCommand{Meta: meta}.Execute(args)
+	}
+
+	return cmd
+}
+
+// OrasPurgeCommand deletes unused package versions from an OCI repository.
+type OrasPurgeCommand struct {
+	Meta
+}
+
+func (c *OrasPurgeCommand) Run(rawArgs []string) int {
+	return RunCommand(OrasPurgeCommander(), c.Meta, rawArgs)
+}
+
+func (c OrasPurgeCommand) Execute(args *arguments.OrasPurge) int {
+	var diags tfdiags.Diagnostics
+	ctx := c.CommandContext()
+
+	b, backendDiags := c.Backend(ctx, nil, encryption.StateEncryptionDisabled())
+	diags = diags.Append(backendDiags)
+	if diags.HasErrors() {
+		c.View.Diagnostics(diags)
+		return 1
+	}
+
+	// The command layer wraps non-"enhanced" backends in the local backend, so
+	// the oras backend is reached through that wrapper.
+	var target any = b
+	if local, ok := b.(*backendLocal.Local); ok && local.Backend != nil {
+		target = local.Backend
+	}
+	purger, ok := target.(orasPurgeBackend)
+	if !ok {
+		diags = diags.Append(tfdiags.Sourceless(
+			tfdiags.Error,
+			"Unsupported backend",
+			"The oras purge command only supports the \"oras\" backend. Configure it in a backend block and run \"tofu init\".",
+		))
+		c.View.Diagnostics(diags)
+		return 1
+	}
+
+	report, err := purger.Purge(ctx, orasstate.PurgeOptions{Apply: args.Apply})
+	if err != nil {
+		diags = diags.Append(tfdiags.Sourceless(
+			tfdiags.Error,
+			"Failed to purge package versions",
+			err.Error(),
+		))
+		c.View.Diagnostics(diags)
+		return 1
+	}
+
+	views.NewOras(c.View).PurgeReport(report, args.Apply)
+	return 0
+}
+
+func (c *OrasPurgeCommand) Help() string {
+	helpText := `
+Usage: tofu [global options] oras purge [options]
+
+  Delete package versions that no live tag references, plus history beyond the
+  configured max_versions, from the OCI repository used by the "oras" backend.
+
+  ghcr.io rejects manifest deletion through the registry API, so this command
+  uses the GitHub Packages API instead. It requires a token with the
+  delete:packages scope and admin access to the package.
+
+  The command is a dry run unless -apply is given. It never deletes the last
+  tagged version of the package, and it refuses to run while a workspace lock
+  is live. Stop all plan and apply runs before using -apply.
+
+Options:
+
+  -apply          Delete the reported versions instead of only listing them.
+`
+	return strings.TrimSpace(helpText)
+}
+
+func (c *OrasPurgeCommand) Synopsis() string {
+	return "Delete unused package versions from the configured GHCR repository"
+}
