+package arguments
+
+import "testing"
+
+func TestStateCompactApplyFlag(t *testing.T) {
+	var cli CommandLine
+	args := BindStateCompact(&cli)
+	if diags := cli.ParseLegacy([]string{"-apply", "ghcr.io/acme/state-next"}); diags.HasErrors() {
+		t.Fatalf("ParseLegacy(-apply destination): %s", diags.Err())
+	}
+	if !args.Apply {
+		t.Fatal("-apply did not enable the copy")
+	}
+	if args.Destination != "ghcr.io/acme/state-next" {
+		t.Fatalf("destination = %q", args.Destination)
+	}
+}
+
+func TestStateCompactDefaultsToPlan(t *testing.T) {
+	var cli CommandLine
+	args := BindStateCompact(&cli)
+	if diags := cli.ParseLegacy([]string{"ghcr.io/acme/state-next"}); diags.HasErrors() {
+		t.Fatalf("ParseLegacy(destination): %s", diags.Err())
+	}
+	if args.Apply {
+		t.Fatal("state compact must be a dry run without -apply")
+	}
+}
+
+func TestStateCompactEmptyDestination(t *testing.T) {
+	var cli CommandLine
+	args := BindStateCompact(&cli)
+	if diags := cli.ParseLegacy(nil); diags.HasErrors() {
+		t.Fatalf("ParseLegacy(nil): %s", diags.Err())
+	}
+	if args.Destination != "" {
+		t.Fatalf("destination = %q, want empty", args.Destination)
+	}
+}
