+++ b/internal/command/arguments/state_compact.go
@@ -0,0 +1,18 @@
+package arguments
+
+// StateCompact represents the command-line arguments for 'state compact'.
+type StateCompact struct {
+	// Destination is the literal registry/repository that receives the copy.
+	Destination string
+
+	// Apply writes the copy. Without it the command only plans.
+	Apply bool
+}
+
+// BindStateCompact registers CLI arguments for 'state compact'.
+func BindStateCompact(cli *CommandLine) *StateCompact {
+	ret := &StateCompact{}
+	cli.BoolVar(&ret.Apply, "apply", false, "Copy the planned artifacts to the destination repository. Without this flag nothing is written.")
+	cli.PositionalArg(&ret.Destination, "destination", true)
+	return ret
+}
