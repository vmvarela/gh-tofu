new file mode 100644
index 000000000..31671fc02
--- /dev/null
+++ b/internal/command/arguments/history_test.go
@@ -0,0 +1,36 @@
+package arguments
+
+import "testing"
+
+func TestHistoryListJSONFlag(t *testing.T) {
+	var cli CommandLine
+	args := BindHistoryList(&cli)
+	if diags := cli.ParseLegacy([]string{"-json"}); diags.HasErrors() {
+		t.Fatalf("ParseLegacy(-json): %s", diags.Err())
+	}
+	if !args.JSON {
+		t.Fatal("-json did not enable JSON output")
+	}
+}
+
+func TestHistoryShowJSONFlag(t *testing.T) {
+	var cli CommandLine
+	args := BindHistoryShow(&cli)
+	if diags := cli.ParseLegacy([]string{"-json", "3"}); diags.HasErrors() {
+		t.Fatalf("ParseLegacy(-json 3): %s", diags.Err())
+	}
+	if !args.JSON || args.Version != "3" {
+		t.Fatalf("parsed show args = %#v", args)
+	}
+}
+
+func TestHistoryPullOutputFlag(t *testing.T) {
+	var cli CommandLine
+	args := BindHistoryPull(&cli)
+	if diags := cli.ParseLegacy([]string{"-output=state.tfstate", "2"}); diags.HasErrors() {
+		t.Fatalf("ParseLegacy pull: %s", diags.Err())
+	}
+	if args.Output != "state.tfstate" || args.Version != "2" {
+		t.Fatalf("parsed pull args = %#v", args)
+	}
+}
