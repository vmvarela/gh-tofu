--- /dev/null
+++ b/internal/command/arguments/history.go
@@ -0,0 +1,35 @@
+package arguments
+
+type HistoryList struct {
+	JSON bool
+}
+
+func BindHistoryList(cli *CommandLine) *HistoryList {
+	ret := &HistoryList{}
+	cli.BoolVar(&ret.JSON, "json", false, "Produce machine-readable JSON output.")
+	return ret
+}
+
+type HistoryShow struct {
+	JSON    bool
+	Version string
+}
+
+func BindHistoryShow(cli *CommandLine) *HistoryShow {
+	ret := &HistoryShow{}
+	cli.BoolVar(&ret.JSON, "json", false, "Produce machine-readable JSON output.")
+	cli.PositionalArg(&ret.Version, "version", false)
+	return ret
+}
+
+type HistoryPull struct {
+	Version string
+	Output  string
+}
+
+func BindHistoryPull(cli *CommandLine) *HistoryPull {
+	ret := &HistoryPull{}
+	cli.StringVar(&ret.Output, "output", "", "Write the historical state to this new file.").SetDisplay("=path")
+	cli.PositionalArg(&ret.Version, "version", false)
+	return ret
+}
