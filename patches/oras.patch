+
+func TestORASAssistantGitOrigin(t *testing.T) {
+	dir := t.TempDir()
+	runGit(t, dir, "init", "-q")
+	runGit(t, dir, "remote", "add", "origin", "git@github.com:org/repo.git")
+	subdir := filepath.Join(dir, "modules", "network")
+	if err := os.MkdirAll(subdir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	origin, ok := gitRemoteOrigin(context.Background(), dir)
+	if !ok || origin != "git@github.com:org/repo.git" {
+		t.Fatalf("gitRemoteOrigin() = %q, %v", origin, ok)
+	}
+	prefix, ok := gitModulePrefix(context.Background(), subdir)
+	if !ok || prefix != "modules/network/" {
+		t.Fatalf("gitModulePrefix() = %q, %v", prefix, ok)
+	}
+}
+
+func TestORASAssistantParsedBackendDetection(t *testing.T) {
+	tests := []struct {
+		name  string
+		files map[string]string
+	}{
+		{"native backend", map[string]string{"main.tf": "terraform {\n  backend \"local\" {}\n}\n"}},
+		{"json backend", map[string]string{"main.tf.json": `{"terraform":{"backend":{"local":{}}}}`}},
+		{"override backend", map[string]string{
+			"main.tf":     "terraform {}\n",
+			"override.tf": "terraform {\n  backend \"local\" {}\n}\n",
+		}},
+		{"cloud block", map[string]string{"main.tf": "terraform {\n  cloud {\n    organization = \"example\"\n  }\n}\n"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			for name, content := range tc.files {
+				writeTestFile(t, filepath.Join(dir, name), content)
+			}
+			t.Chdir(dir)
+
+			view, done := testView(t)
+			defer done(t)
+			c := &InitCommand{Meta: Meta{WorkingDir: workdir.NewDir("."), View: view}}
+			mod, diags := c.loadSingleModuleWithTests(context.Background(), ".", "tests")
+			if diags.HasErrors() {
+				t.Fatalf("failed to load fixture: %s", diags.Err())
+			}
+			if mod.Backend == nil && mod.CloudConfig == nil {
+				t.Fatal("parser did not detect the configured backend or cloud block")
+			}
+		})
+	}
+}
+
+func writeTestFile(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func runGit(t *testing.T, dir string, args ...string) {
+	t.Helper()
+	command := exec.Command("git", append([]string{"-C", dir}, args...)...)
+	if out, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("git %v: %s\n%s", args, err, out)
+	}
+}
diff --git a/internal/command/init_oras_test.go b/internal/command/init_oras_test.go
new file mode 100644
index 000000000..8f931c463
--- /dev/null
+++ b/internal/command/init_oras_test.go
@@ -0,0 +1,141 @@
+package command
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/opentofu/opentofu/internal/command/workdir"
+)
+
+// The ORAS repository must come from the literal backend block, end to end
+// through `init`; the schema alone does not prove it.
+func runOrasInit(t *testing.T, fixture string, env map[string]string, args ...string) (int, string) {
+	t.Helper()
+	td := t.TempDir()
+	testCopyDir(t, testFixturePath(fixture), td)
+	t.Chdir(td)
+	for k, v := range env {
+		t.Setenv(k, v)
+	}
+	view, done := testView(t)
+	meta := Meta{
+		WorkingDir:       workdir.NewDir("."),
+		testingOverrides: metaOverridesForProvider(testProvider()),
+		View:             view,
+	}
+	code := RunCommander(t, InitCommander(), meta, args)
+	out := done(t)
+	return code, out.Stderr()
+}
+
+func TestInitOras_RepositoryNotSatisfiedByEnv(t *testing.T) {
+	code, stderr := runOrasInit(t, "init-oras-no-repository",
+		map[string]string{"TF_BACKEND_ORAS_REPOSITORY": "127.0.0.1:1/ns/from-env"},
+		"-input=false")
+	if code == 0 {
+		t.Fatal("init succeeded with repository supplied only by environment")
+	}
+	if !strings.Contains(stderr, "requires repository to be set literally") {
+		t.Fatalf("unexpected diagnostics: %s", stderr)
+	}
+}
+
+func TestInitOras_BackendConfigCannotSetRepository(t *testing.T) {
+	code, stderr := runOrasInit(t, "init-oras-literal", nil,
+		"-input=false", "-backend-config=repository=127.0.0.1:2/ns/other")
+	if code == 0 {
+		t.Fatal("init accepted -backend-config repository override")
+	}
+	if !strings.Contains(stderr, "-backend-config cannot set repository") {
+		t.Fatalf("unexpected diagnostics: %s", stderr)
+	}
+}
+
+// Dynamic and null forms can be satisfied from the environment, variables,
+// locals, or functions; each must be rejected from the literal backend block.
+func TestInitOras_RepositoryMustBeLiteral(t *testing.T) {
+	tests := []struct {
+		name    string
+		fixture string
+		env     map[string]string
+	}{
+		{"variable from TF_VAR", "init-oras-var", map[string]string{"TF_VAR_repo": "127.0.0.1:1/ns/from-tf-var"}},
+		{"function call", "init-oras-function", nil},
+		{"null", "init-oras-null", nil},
+		{"local", "init-oras-local", nil},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			code, stderr := runOrasInit(t, tc.fixture, tc.env, "-input=false")
+			if code == 0 {
+				t.Fatal("init accepted a non-literal repository")
+			}
+			if !strings.Contains(stderr, "repository must be a literal string") {
+				t.Fatalf("unexpected diagnostics: %s", stderr)
+			}
+		})
+	}
+}
+
+// .tf.json backend blocks: a JSON string is evaluated as a template when OpenTofu
+// has a context, so an interpolated repository must be rejected as well.
+func TestInitOras_JSONRepositoryMustBeLiteral(t *testing.T) {
+	tests := []struct {
+		name    string
+		fixture string
+		env     map[string]string
+	}{
+		{"file() interpolation", "init-oras-json-file", nil},
+		{"variable interpolation from TF_VAR", "init-oras-json-var", map[string]string{"TF_VAR_repo": "127.0.0.1:1/ns/from-tf-var"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			code, stderr := runOrasInit(t, tc.fixture, tc.env, "-input=false")
+			if code == 0 {
+				t.Fatal("init accepted an interpolated JSON repository")
+			}
+			if !strings.Contains(stderr, "repository must be a literal string") {
+				t.Fatalf("unexpected diagnostics: %s", stderr)
+			}
+		})
+	}
+}
+
+func TestInitOras_JSONLiteralPassesCheck(t *testing.T) {
+	// The plain JSON literal passes the repository check; any remaining failure is
+	// the connection to the closed port, not the literal rule.
+	_, stderr := runOrasInit(t, "init-oras-json-literal", nil, "-input=false")
+	if strings.Contains(stderr, "requires repository") || strings.Contains(stderr, "must be a literal string") || strings.Contains(stderr, "cannot set repository") {
+		t.Fatalf("plain JSON literal repository rejected: %s", stderr)
+	}
+}
+
+func TestInitOras_BackendConfigFileCannotSetRepository(t *testing.T) {
+	code, stderr := runOrasInit(t, "init-oras-literal", nil,
+		"-input=false", "-backend-config=override.hcl")
+	if code == 0 {
+		t.Fatal("init accepted repository from a -backend-config file")
+	}
+	if !strings.Contains(stderr, "-backend-config cannot set repository") {
+		t.Fatalf("unexpected diagnostics: %s", stderr)
+	}
+}
+
+func TestInitOras_LiteralRepositoryPassesCheck(t *testing.T) {
+	// The literal backend passes the repository check; any remaining failure is
+	// the connection attempt to the closed port, not the repository rule.
+	_, stderr := runOrasInit(t, "init-oras-literal", nil, "-input=false")
+	if strings.Contains(stderr, "requires repository") || strings.Contains(stderr, "cannot set repository") {
+		t.Fatalf("literal repository rejected: %s", stderr)
+	}
+}
+
+func TestInitOras_GHCRRejectsInsecure(t *testing.T) {
+	code, stderr := runOrasInit(t, "init-oras-ghcr-insecure", nil, "-input=false")
+	if code == 0 {
+		t.Fatal("init accepted insecure=true for ghcr.io")
+	}
+	if !strings.Contains(stderr, "insecure must be false for ghcr.io") {
+		t.Fatalf("unexpected diagnostics: %s", stderr)
+	}
+}
