@@ -0,0 +1,65 @@
+package oras
+
+import "testing"
+
+func TestInferRepository(t *testing.T) {
+	tests := []struct {
+		name   string
+		origin string
+		prefix string
+		want   string
+		ok     bool
+	}{
+		{"https with git suffix", "https://github.com/Org/Repo.git", "", "ghcr.io/org/repo-tfstate", true},
+		{"https without suffix", "https://github.com/org/repo", "", "ghcr.io/org/repo-tfstate", true},
+		{"https trailing slash", "https://github.com/org/repo.git/", "", "ghcr.io/org/repo-tfstate", true},
+		{"ssh url", "ssh://git@github.com/org/repo.git", "", "ghcr.io/org/repo-tfstate", true},
+		{"scp style", "git@github.com:org/repo.git", "", "ghcr.io/org/repo-tfstate", true},
+		{"module subdirectory", "https://github.com/org/repo.git", "modules/network/", "ghcr.io/org/repo-tfstate/modules/network", true},
+		{"uppercase prefix", "git@github.com:org/repo.git", "Infra/", "ghcr.io/org/repo-tfstate/infra", true},
+		{"subdomain", "https://www.github.com/org/repo.git", "", "", false},
+		{"lookalike host", "https://github.com.example.com/org/repo.git", "", "", false},
+		{"enterprise host", "git@github.example.com:org/repo.git", "", "", false},
+		{"http origin", "http://github.com/org/repo.git", "", "", false},
+		{"git scheme", "git://github.com/org/repo.git", "", "", false},
+		{"wrong ssh user", "ssh://root@github.com/org/repo.git", "", "", false},
+		{"https credentials", "https://user@github.com/org/repo.git", "", "", false},
+		{"extra path", "https://github.com/org/repo/tree/main", "", "", false},
+		{"missing repository", "https://github.com/org", "", "", false},
+		{"empty origin", "", "", "", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, ok := InferRepository(tc.origin, tc.prefix)
+			if got != tc.want || ok != tc.ok {
+				t.Fatalf("InferRepository(%q, %q) = %q, %v; want %q, %v", tc.origin, tc.prefix, got, ok, tc.want, tc.ok)
+			}
+		})
+	}
+}
+
+func TestValidateRepository(t *testing.T) {
+	for _, repository := range []string{
+		"ghcr.io/org/state",
+		"ghcr.io/org/state/modules/network",
+		"127.0.0.1:5000/ns/state",
+		"ghcr.io:5000/org/state",
+	} {
+		if err := ValidateRepository(repository); err != nil {
+			t.Errorf("ValidateRepository(%q) = %v, want nil", repository, err)
+		}
+	}
+	for _, repository := range []string{
+		"",
+		"ghcr.io/org/state:",
+		"ghcr.io/org/state@",
+		"ghcr.io/org/state:tag@",
+		"ghcr.io/org/state:latest",
+		"ghcr.io/org/state@sha256:abc",
+		"not a repository",
+	} {
+		if err := ValidateRepository(repository); err == nil {
+			t.Errorf("ValidateRepository(%q) = nil, want error", repository)
+		}
+	}
+}
diff --git a/internal/backend/remote-state/oras/auth_exchange_test.go b/internal/backend/remote-state/oras/auth_exchange_test.go
new file mode 100644
index 000000000..56c2d66ce
--- /dev/null
+++ b/internal/backend/remote-state/oras/auth_exchange_test.go
@@ -0,0 +1,281 @@
+package oras
+
+import (
+	"context"
+	"crypto/tls"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	orasstate "github.com/vmvarela/oras-state"
+)
+
+// These tests drive the real oras-state/oras-go auth exchange through the guarded
+// client: the challenge, realm validation, the OAuth2 form POST, the distribution
+// GET fallback, and redirects. A registry answers only with the expected secret,
+// so an unguarded credential send to an attacker would visibly succeed.
+
+const (
+	exchangeSecret = "SECRET-PASSWORD-123"
+	exchangeToken  = "bearer-token-456"
+	formType       = "application/x-www-form-urlencoded"
+)
+
+type fakeAuthServer struct {
+	srv *httptest.Server
+
+	realm            string // bearer challenge realm for /v2/ requests
+	postUnsupported  bool   // POST /token answers 404, forcing the GET fallback
+	tokenRedirect    string // POST /token answers 307 to this URL
+	getTokenRedirect string // GET /token answers 307 to this URL
+
+	mu       sync.Mutex
+	hits     []string // "METHOD PATH" for every request
+	credHits int      // requests that carried credentials
+}
+
+func newFakeAuthServer(t *testing.T) *fakeAuthServer {
+	t.Helper()
+	f := &fakeAuthServer{}
+	f.srv = httptest.NewTLSServer(http.HandlerFunc(f.serve))
+	t.Cleanup(f.srv.Close)
+	return f
+}
+
+func (f *fakeAuthServer) host() string { return strings.TrimPrefix(f.srv.URL, "https://") }
+
+func (f *fakeAuthServer) hitOnPath(path string) bool {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	for _, h := range f.hits {
+		if strings.HasSuffix(h, " "+path) {
+			return true
+		}
+	}
+	return false
+}
+
+func (f *fakeAuthServer) anyHits() bool {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return len(f.hits) > 0
+}
+
+func (f *fakeAuthServer) credentialHits() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.credHits
+}
+
+func (f *fakeAuthServer) serve(w http.ResponseWriter, r *http.Request) {
+	f.mu.Lock()
+	f.hits = append(f.hits, r.Method+" "+r.URL.Path)
+	if r.Header.Get("Authorization") != "" || r.Header.Get("Content-Type") == formType {
+		f.credHits++
+	}
+	f.mu.Unlock()
+
+	writeToken := func() {
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]string{"access_token": exchangeToken, "token": exchangeToken})
+	}
+	switch {
+	case r.URL.Path == "/token" && r.Method == http.MethodPost:
+		if f.tokenRedirect != "" {
+			http.Redirect(w, r, f.tokenRedirect, http.StatusTemporaryRedirect)
+			return
+		}
+		if f.postUnsupported {
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		_ = r.ParseForm()
+		if r.PostForm.Get("username") != "x" || r.PostForm.Get("password") != exchangeSecret {
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		writeToken()
+	case r.URL.Path == "/token" && r.Method == http.MethodGet:
+		if f.getTokenRedirect != "" {
+			http.Redirect(w, r, f.getTokenRedirect, http.StatusTemporaryRedirect)
+			return
+		}
+		if u, p, ok := r.BasicAuth(); !ok || u != "x" || p != exchangeSecret {
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		writeToken()
+	case strings.HasPrefix(r.URL.Path, "/v2/"):
+		if r.Header.Get("Authorization") != "Bearer "+exchangeToken {
+			w.Header().Set("WWW-Authenticate", `Bearer realm="`+f.realm+`",service="ghcr.io",scope="repository:ns/state:pull"`)
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"name":"ns/state","tags":["state-x"]}`))
+	default:
+		// Any other path behaves like a valid token endpoint: an unguarded request
+		// to it would succeed and be detected by the assertions.
+		writeToken()
+	}
+}
+
+// runExchange lists the state repository through a real orasstate.Client whose HTTP
+// client is the guard, and reports whether the authenticated listing returned the
+// state tag served only to a valid bearer token. oras-state maps some errors to
+// the default workspace, so an error alone is not a reliable signal.
+func runExchange(t *testing.T, guard *credentialGuard, reg *fakeAuthServer) (bool, error) {
+	t.Helper()
+	guard.inner = &http.Transport{TLSClientConfig: &tls.Config{InsecureSkipVerify: true}} //nolint:gosec // test-only self-signed servers
+	client, err := orasstate.NewClient(reg.host(), "ns/state", orasstate.Config{
+		WorkspaceLayout: orasstate.WorkspaceLayoutLegacy,
+		HTTPClient:      &http.Client{Transport: guard},
+		CredentialFunc: func(context.Context, string) (orasstate.Credential, error) {
+			return orasstate.Credential{Username: "x", Password: exchangeSecret}, nil
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	workspaces, err := client.List(context.Background())
+	authenticated := false
+	for _, ws := range workspaces {
+		authenticated = authenticated || ws == "x"
+	}
+	return authenticated, err
+}
+
+func TestAuthExchangeThroughGuard(t *testing.T) {
+	t.Setenv("ORAS_TOKEN", "")
+	t.Setenv("GH_TOKEN", "")
+	t.Setenv("GITHUB_TOKEN", "")
+
+	type scenario struct {
+		name string
+		// mode selects the guard: "ghcr", "insecure", or "secure".
+		mode  string
+		setup func(reg, att *fakeAuthServer)
+		// wantOK is whether the list must succeed.
+		wantOK bool
+		// wantRegHit is a registry path the exchange must reach when wantOK.
+		wantRegHit string
+		// forbidRegPath is a registry path that must not be reached.
+		forbidRegPath string
+		// attackerMayReceiveCreds is set only for the ordinary secure cross-host realm.
+		attackerMayReceiveCreds bool
+		// attackerSilent requires the attacker server to see no request at all.
+		attackerSilent bool
+	}
+	scenarios := []scenario{
+		{
+			name: "GHCR expected OAuth2 form exchange succeeds", mode: "ghcr", wantOK: true, wantRegHit: "/token",
+			setup: func(reg, _ *fakeAuthServer) { reg.realm = "https://" + reg.host() + "/token" },
+		},
+		{
+			name: "GHCR expected distribution fallback succeeds", mode: "ghcr", wantOK: true, wantRegHit: "/token",
+			setup: func(reg, _ *fakeAuthServer) {
+				reg.realm = "https://" + reg.host() + "/token"
+				reg.postUnsupported = true
+			},
+		},
+		{
+			name: "GHCR attacker realm host refused", mode: "ghcr", attackerSilent: true,
+			setup: func(reg, att *fakeAuthServer) { reg.realm = "https://" + att.host() + "/token" },
+		},
+		{
+			name: "GHCR attacker path on expected host refused", mode: "ghcr", forbidRegPath: "/evil-token",
+			setup: func(reg, _ *fakeAuthServer) { reg.realm = "https://" + reg.host() + "/evil-token" },
+		},
+		{
+			name: "GHCR same-origin redirect to attacker path refused", mode: "ghcr", forbidRegPath: "/evil-token",
+			setup: func(reg, _ *fakeAuthServer) {
+				reg.realm = "https://" + reg.host() + "/token"
+				reg.tokenRedirect = "https://" + reg.host() + "/evil-token"
+			},
+		},
+		{
+			name: "GHCR cross-origin redirect of form POST to attacker refused", mode: "ghcr", attackerSilent: true,
+			setup: func(reg, att *fakeAuthServer) {
+				reg.realm = "https://" + reg.host() + "/token"
+				reg.tokenRedirect = "https://" + att.host() + "/token"
+			},
+		},
+		{
+			name: "GHCR GET fallback redirected to attacker refused", mode: "ghcr",
+			setup: func(reg, att *fakeAuthServer) {
+				reg.realm = "https://" + reg.host() + "/token"
+				reg.postUnsupported = true
+				reg.getTokenRedirect = "https://" + att.host() + "/token"
+			},
+		},
+		{
+			name: "GHCR GET fallback redirected to attacker path refused", mode: "ghcr", forbidRegPath: "/evil-token",
+			setup: func(reg, _ *fakeAuthServer) {
+				reg.realm = "https://" + reg.host() + "/token"
+				reg.postUnsupported = true
+				reg.getTokenRedirect = "https://" + reg.host() + "/evil-token"
+			},
+		},
+		{
+			name: "insecure attacker realm host refused", mode: "insecure", attackerSilent: true,
+			setup: func(reg, att *fakeAuthServer) { reg.realm = "https://" + att.host() + "/token" },
+		},
+		{
+			name: "insecure expected realm on registry host succeeds", mode: "insecure", wantOK: true, wantRegHit: "/token",
+			setup: func(reg, _ *fakeAuthServer) { reg.realm = "https://" + reg.host() + "/token" },
+		},
+		{
+			name: "secure ordinary registry cross-host HTTPS realm keeps Docker-style fallback", mode: "secure",
+			wantOK: true, attackerMayReceiveCreds: true,
+			setup: func(reg, att *fakeAuthServer) { reg.realm = "https://" + att.host() + "/token" },
+		},
+	}
+
+	for _, sc := range scenarios {
+		t.Run(sc.name, func(t *testing.T) {
+			reg := newFakeAuthServer(t)
+			att := newFakeAuthServer(t)
+			sc.setup(reg, att)
+
+			var guard *credentialGuard
+			switch sc.mode {
+			case "ghcr":
+				guard = &credentialGuard{registry: reg.host(), ghcr: &ghcrEndpoints{tokenHost: reg.host(), apiHost: "api.invalid"}}
+			case "insecure":
+				guard = &credentialGuard{registry: reg.host(), insecure: true}
+			default:
+				guard = &credentialGuard{registry: reg.host()}
+			}
+
+			authenticated, err := runExchange(t, guard, reg)
+			if sc.wantOK && !authenticated {
+				t.Fatalf("expected authenticated listing, got err=%v", err)
+			}
+			if !sc.wantOK && authenticated {
+				t.Fatal("expected the exchange to be refused, but the authenticated listing succeeded")
+			}
+			if err != nil && strings.Contains(err.Error(), exchangeSecret) {
+				t.Fatalf("error disclosed the password: %v", err)
+			}
+			if sc.wantRegHit != "" && !reg.hitOnPath(sc.wantRegHit) {
+				t.Fatalf("exchange did not reach %s on the registry", sc.wantRegHit)
+			}
+			if sc.forbidRegPath != "" && reg.hitOnPath(sc.forbidRegPath) {
+				t.Fatalf("request reached forbidden path %s", sc.forbidRegPath)
+			}
+			if !sc.attackerMayReceiveCreds {
+				if n := att.credentialHits(); n != 0 {
+					t.Fatalf("attacker received %d credentialed requests", n)
+				}
+				if sc.attackerSilent && att.anyHits() {
+					t.Fatal("attacker realm was contacted")
+				}
+			} else if !att.anyHits() {
+				t.Fatal("ordinary cross-host realm was not used")
+			}
+		})
+	}
+}
diff --git a/internal/backend/remote-state/oras/backend.go b/internal/backend/remote-state/oras/backend.go
new file mode 100644
index 000000000..1d0005e36
--- /dev/null
+++ b/internal/backend/remote-state/oras/backend.go
@@ -0,0 +1,425 @@
+package oras
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os/exec"
+	"sort"
+	"strings"
+	"time"
+
+	orasstate "github.com/vmvarela/oras-state"
+
+	"github.com/opentofu/opentofu/internal/backend"
+	"github.com/opentofu/opentofu/internal/command/cliconfig"
+	"github.com/opentofu/opentofu/internal/command/cliconfig/ociauthconfig"
+	"github.com/opentofu/opentofu/internal/encryption"
+	"github.com/opentofu/opentofu/internal/httpclient"
+	"github.com/opentofu/opentofu/internal/legacy/helper/schema"
+	"github.com/opentofu/opentofu/internal/logging"
+	"github.com/opentofu/opentofu/internal/states/remote"
+	"github.com/opentofu/opentofu/internal/states/statemgr"
+	"github.com/opentofu/opentofu/version"
+
+	orasRemote "oras.land/oras-go/v2/registry/remote"
+	orasAuth "oras.land/oras-go/v2/registry/remote/auth"
+)
+
+const (
+	envVarRetryMax     = "TF_BACKEND_ORAS_RETRY_MAX"
+	envVarRetryWaitMin = "TF_BACKEND_ORAS_RETRY_WAIT_MIN"
+	envVarRetryWaitMax = "TF_BACKEND_ORAS_RETRY_WAIT_MAX"
+	envVarLockTTL      = "TF_BACKEND_ORAS_LOCK_TTL"
+	envVarRateLimit    = "TF_BACKEND_ORAS_RATE_LIMIT"
+	envVarRateBurst    = "TF_BACKEND_ORAS_RATE_LIMIT_BURST"
+	envVarMaxStateSize = "TF_BACKEND_ORAS_MAX_STATE_SIZE"
+)
+
+type Backend struct {
+	*schema.Backend
+	encryption encryption.StateEncryption
+
+	repository   string
+	insecure     bool
+	caFile       string
+	compression  string
+	lockTTL      time.Duration
+	rateLimit    int
+	rateBurst    int
+	retryCfg     RetryConfig
+	stateMaxSize int64
+
+	versioningMaxVersions int
+
+	orasCredsPolicy cliconfigORASCredentialsPolicy
+	client          *orasstate.Client
+}
+
+func New(enc encryption.StateEncryption) backend.Backend {
+	s := &schema.Backend{
+		Schema: map[string]*schema.Schema{
+			"repository": {
+				Type:        schema.TypeString,
+				Required:    true,
+				Description: "OCI repository in the form <registry>/<repository>, without tag or digest. Must be set in the backend block; environment variables are not read.",
+			},
+			"insecure": {
+				Type:        schema.TypeBool,
+				Optional:    true,
+				Default:     false,
+				Description: "Use an insecure OCI registry connection",
+			},
+			"ca_file": {
+				Type:        schema.TypeString,
+				Optional:    true,
+				Description: "Path to a PEM-encoded CA certificate bundle to trust when communicating with the OCI registry",
+			},
+			"retry_max": {
+				Type:        schema.TypeInt,
+				Optional:    true,
+				DefaultFunc: schema.EnvDefaultFunc(envVarRetryMax, 2),
+				Description: "The number of retries for transient registry requests.",
+			},
+			"retry_wait_min": {
+				Type:        schema.TypeInt,
+				Optional:    true,
+				DefaultFunc: schema.EnvDefaultFunc(envVarRetryWaitMin, 1),
+				Description: "The minimum time in seconds to wait between transient registry request attempts.",
+			},
+			"retry_wait_max": {
+				Type:        schema.TypeInt,
+				Optional:    true,
+				DefaultFunc: schema.EnvDefaultFunc(envVarRetryWaitMax, 30),
+				Description: "The maximum time in seconds to wait between transient registry request attempts.",
+			},
+			"compression": {
+				Type:        schema.TypeString,
+				Optional:    true,
+				Default:     "none",
+				Description: "State compression. Supported values: none, gzip.",
+			},
+			"lock_ttl": {
+				Type:        schema.TypeInt,
+				Optional:    true,
+				DefaultFunc: schema.EnvDefaultFunc(envVarLockTTL, 0),
+				Description: "Lock TTL in seconds. 0 disables automatic stale lock clearing.",
+			},
+			"rate_limit": {
+				Type:        schema.TypeInt,
+				Optional:    true,
+				DefaultFunc: schema.EnvDefaultFunc(envVarRateLimit, 0),
+				Description: "Maximum registry requests per second. 0 disables rate limiting.",
+			},
+			"rate_limit_burst": {
+				Type:        schema.TypeInt,
+				Optional:    true,
+				DefaultFunc: schema.EnvDefaultFunc(envVarRateBurst, 0),
+				Description: "Maximum burst size for registry requests when rate limiting is enabled. 0 defaults to 1.",
+			},
+			"max_versions": {
+				Type:        schema.TypeInt,
+				Optional:    true,
+				Default:     0,
+				Description: "Maximum number of historical state versions to retain. 0 disables versioning.",
+			},
+			"max_state_size": {
+				Type:        schema.TypeInt,
+				Optional:    true,
+				DefaultFunc: schema.EnvDefaultFunc(envVarMaxStateSize, 0),
+				Description: "Maximum state size in bytes. 0 uses the 256 MiB default.",
+			},
+		},
+	}
+
+	b := &Backend{Backend: s, encryption: enc}
+	b.Backend.ConfigureFunc = b.configure
+	return b
+}
+
+func (b *Backend) configure(ctx context.Context) error {
+	data := schema.FromContextBackendConfig(ctx)
+
+	repository := data.Get("repository").(string)
+	if repository == "" {
+		return fmt.Errorf("repository must not be empty; set it in the backend block")
+	}
+
+	ref, err := parseRepository(repository)
+	if err != nil {
+		return err
+	}
+
+	insecure := data.Get("insecure").(bool)
+	if err := rejectInsecureGHCR(ref.Registry, insecure); err != nil {
+		return err
+	}
+	b.repository = repository
+	b.insecure = insecure
+	b.caFile = data.Get("ca_file").(string)
+
+	b.compression = strings.ToLower(strings.TrimSpace(data.Get("compression").(string)))
+	if b.compression == "" {
+		b.compression = "none"
+	}
+	if b.compression != "none" && b.compression != "gzip" {
+		return fmt.Errorf("unsupported compression %q (supported: none, gzip)", b.compression)
+	}
+
+	lockTTLSeconds := data.Get("lock_ttl").(int)
+	if lockTTLSeconds < 0 {
+		return fmt.Errorf("lock_ttl must be non-negative")
+	}
+	b.lockTTL = time.Duration(lockTTLSeconds) * time.Second
+
+	b.rateLimit = data.Get("rate_limit").(int)
+	b.rateBurst = data.Get("rate_limit_burst").(int)
+	if b.rateLimit < 0 {
+		return fmt.Errorf("rate_limit must be non-negative")
+	}
+	if b.rateBurst < 0 {
+		return fmt.Errorf("rate_limit_burst must be non-negative")
+	}
+
+	retryMax := data.Get("retry_max").(int)
+	retryWaitMin := time.Duration(data.Get("retry_wait_min").(int)) * time.Second
+	retryWaitMax := time.Duration(data.Get("retry_wait_max").(int)) * time.Second
+	b.retryCfg = RetryConfig{
+		MaxAttempts:       max(retryMax+1, 1),
+		InitialBackoff:    retryWaitMin,
+		MaxBackoff:        retryWaitMax,
+		BackoffMultiplier: 2,
+	}
+	if b.retryCfg.InitialBackoff <= 0 {
+		b.retryCfg.InitialBackoff = time.Second
+	}
+	if b.retryCfg.MaxBackoff > 0 && b.retryCfg.MaxBackoff < b.retryCfg.InitialBackoff {
+		b.retryCfg.MaxBackoff = b.retryCfg.InitialBackoff
+	}
+
+	b.versioningMaxVersions = max(data.Get("max_versions").(int), 0)
+
+	maxStateSize := data.Get("max_state_size").(int)
+	if maxStateSize < 0 {
+		return fmt.Errorf("max_state_size must be non-negative")
+	}
+	b.stateMaxSize = int64(maxStateSize)
+
+	cliCfg, diags := cliconfig.LoadConfig(ctx)
+	if diags.HasErrors() {
+		return diags.Err()
+	}
+	policy, err := cliCfg.OCICredentialsPolicy(ctx)
+	if err != nil {
+		return err
+	}
+	b.orasCredsPolicy = realORASCredentialsPolicy{policy: policy}
+
+	credFunc, err := b.orasCredsPolicy.CredentialFunc(ctx, b.repository)
+	if err != nil {
+		return err
+	}
+
+	httpClient, err := newHTTPClient(ref.Registry, b.insecure, b.caFile, b.rateLimit, b.rateBurst)
+	if err != nil {
+		return err
+	}
+
+	cfg := orasstate.Config{
+		WorkspaceLayout: orasstate.WorkspaceLayoutLegacy,
+		PlainHTTP:       b.insecure,
+		TLSSkipVerify:   b.insecure,
+		CAFile:          b.caFile,
+		Compression:     b.compression == "gzip",
+		LockTTL:         b.lockTTL,
+		MaxVersions:     b.versioningMaxVersions,
+		MaxStateSize:    b.stateMaxSize,
+		HTTPClient:      httpClient,
+		UserAgent:       httpclient.OpenTofuUserAgent(version.Version),
+	}
+	if credFunc != nil {
+		cfg.CredentialFunc = func(ctx context.Context, hostport string) (orasstate.Credential, error) {
+			cred, err := credFunc(ctx, hostport)
+			if err != nil {
+				return orasstate.Credential{}, err
+			}
+			return orasstate.Credential{
+				Username:    cred.Username,
+				Password:    cred.Password,
+				AccessToken: cred.AccessToken,
+			}, nil
+		}
+	}
+
+	b.client, err = orasstate.NewClient(ref.Registry, ref.Repository, cfg)
+	return err
+}
+
+func (b *Backend) StateMgr(_ context.Context, workspace string) (statemgr.Full, error) {
+	if b.client == nil {
+		return nil, fmt.Errorf("backend is not configured")
+	}
+	client := &RemoteClient{client: b.client, workspace: workspace, retryCfg: b.retryCfg}
+	return &historyState{
+		Full:       remote.NewState(client, b.encryption),
+		client:     b.client,
+		workspace:  workspace,
+		encryption: b.encryption,
+	}, nil
+}
+
+type historyState struct {
+	statemgr.Full
+	client     *orasstate.Client
+	workspace  string
+	encryption encryption.StateEncryption
+}
+
+var _ statemgr.History = (*historyState)(nil)
+
+func (s *historyState) ListVersions(ctx context.Context) ([]statemgr.StateVersion, error) {
+	versions, err := s.client.ListVersions(ctx, s.workspace)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]statemgr.StateVersion, len(versions))
+	for i, version := range versions {
+		out[i] = statemgr.StateVersion{
+			Version:   version.Version,
+			UpdatedAt: version.UpdatedAt,
+			Digest:    version.Digest,
+		}
+	}
+	return out, nil
+}
+
+func (s *historyState) GetVersion(ctx context.Context, version int) ([]byte, error) {
+	data, err := s.client.GetVersion(ctx, s.workspace, version)
+	if err != nil {
+		return nil, err
+	}
+	plain, _, err := s.encryption.DecryptState(data)
+	if err != nil {
+		return nil, fmt.Errorf("decrypting historical state version %d: %w", version, err)
+	}
+	return plain, nil
+}
+
+func (b *Backend) Workspaces(ctx context.Context) ([]string, error) {
+	if b.client == nil {
+		return nil, fmt.Errorf("backend is not configured")
+	}
+	workspaces, err := withRetry(ctx, b.retryCfg, func(ctx context.Context) ([]string, error) {
+		return b.client.List(ctx)
+	})
+	if err != nil {
+		return nil, err
+	}
+	for _, workspace := range workspaces {
+		if workspace == backend.DefaultStateName {
+			return workspaces, nil
+		}
+	}
+	workspaces = append(workspaces, backend.DefaultStateName)
+	sort.Strings(workspaces)
+	return workspaces, nil
+}
+
+func (b *Backend) DeleteWorkspace(ctx context.Context, name string, _ bool) error {
+	if b.client == nil {
+		return fmt.Errorf("backend is not configured")
+	}
+	if name == backend.DefaultStateName || name == "" {
+		return fmt.Errorf("can't delete default state")
+	}
+	// Not retried: a retry re-resolves the workspace and could delete a newer writer's state.
+	return b.client.DeleteWorkspace(ctx, name)
+}
+
+type cliconfigORASCredentialsPolicy interface {
+	CredentialFunc(ctx context.Context, repository string) (credentialFunc, error)
+}
+
+type credentialFunc func(ctx context.Context, hostport string) (orasAuth.Credential, error)
+
+type realORASCredentialsPolicy struct {
+	policy ociauthconfig.CredentialsConfigs
+}
+
+func (p realORASCredentialsPolicy) CredentialFunc(ctx context.Context, repository string) (credentialFunc, error) {
+	repo, err := orasRemote.NewRepository(repository)
+	if err != nil {
+		return nil, err
+	}
+	registryDomain := repo.Reference.Registry
+	repositoryPath := repo.Reference.Repository
+	lookupEnv := dockerCredentialHelperEnv{}
+	ghTokens := &githubTokenSource{}
+
+	return func(ctx context.Context, _ string) (orasAuth.Credential, error) {
+		// GitHub tokens are only ever presented to GHCR; other registries never see them.
+		if strings.EqualFold(registryDomain, ghcrRegistry) {
+			token, err := ghTokens.token(ctx)
+			if err != nil {
+				logging.HCLogger().Warn("GitHub token unavailable for GHCR; falling back to OCI credentials", "error", err)
+			} else if token != "" {
+				return ghcrCredential(token), nil
+			}
+		}
+
+		source, err := p.policy.CredentialsSourceForRepository(ctx, registryDomain, repositoryPath)
+		if err != nil {
+			// No configured credentials means anonymous access, as in the source branch below.
+			if ociauthconfig.IsCredentialsNotFoundError(err) {
+				return orasAuth.EmptyCredential, nil
+			}
+			return orasAuth.EmptyCredential, err
+		}
+		creds, err := source.Credentials(ctx, lookupEnv)
+		if err != nil {
+			if ociauthconfig.IsCredentialsNotFoundError(err) {
+				return orasAuth.EmptyCredential, nil
+			}
+			return orasAuth.EmptyCredential, err
+		}
+		return creds.ToORASCredential(), nil
+	}, nil
+}
+
+type dockerCredentialHelperEnv struct{}
+
+var _ ociauthconfig.CredentialsLookupEnvironment = dockerCredentialHelperEnv{}
+
+const credentialHelperTimeout = 30 * time.Second
+
+func (dockerCredentialHelperEnv) QueryDockerCredentialHelper(ctx context.Context, helperName string, serverURL string) (ociauthconfig.DockerCredentialHelperGetResult, error) {
+	exe := "docker-credential-" + helperName
+
+	tctx, cancel := context.WithTimeout(ctx, credentialHelperTimeout)
+	defer cancel()
+
+	cmd := exec.CommandContext(tctx, exe, "get")
+	cmd.Stdin = strings.NewReader(serverURL)
+	stdout, err := cmd.Output()
+	if err != nil {
+		if tctx.Err() == context.DeadlineExceeded {
+			logging.HCLogger().Warn("credential helper timed out", "helper", exe, "timeout", credentialHelperTimeout)
+			return ociauthconfig.DockerCredentialHelperGetResult{}, fmt.Errorf("credential helper %q timed out after %s: %w", exe, credentialHelperTimeout, context.DeadlineExceeded)
+		}
+		var exitErr *exec.ExitError
+		if errors.As(err, &exitErr) && exitErr.ExitCode() == 1 {
+			return ociauthconfig.DockerCredentialHelperGetResult{}, ociauthconfig.NewCredentialsNotFoundError(err)
+		}
+		return ociauthconfig.DockerCredentialHelperGetResult{}, err
+	}
+
+	var result ociauthconfig.DockerCredentialHelperGetResult
+	if err := json.Unmarshal(stdout, &result); err != nil {
+		return ociauthconfig.DockerCredentialHelperGetResult{}, fmt.Errorf("parsing credential helper response: %w", err)
+	}
+	if result.ServerURL == "" {
+		result.ServerURL = serverURL
+	}
+	return result, nil
+}
diff --git a/internal/backend/remote-state/oras/client.go b/internal/backend/remote-state/oras/client.go
new file mode 100644
index 000000000..452c0851d
--- /dev/null
+++ b/internal/backend/remote-state/oras/client.go
@@ -0,0 +1,113 @@
+package oras
+
+import (
+	"context"
+	"crypto/md5"
+	"errors"
+	"fmt"
+
+	orasstate "github.com/vmvarela/oras-state"
+
+	"github.com/opentofu/opentofu/internal/states/remote"
+	"github.com/opentofu/opentofu/internal/states/statemgr"
+)
+
+type RemoteClient struct {
+	client    *orasstate.Client
+	workspace string
+	retryCfg  RetryConfig
+	lockID    string // id returned by Lock; verified before Put
+}
+
+var _ remote.Client = (*RemoteClient)(nil)
+var _ remote.ClientLocker = (*RemoteClient)(nil)
+
+func (c *RemoteClient) Get(ctx context.Context) (*remote.Payload, error) {
+	data, err := withRetry(ctx, c.retryCfg, func(ctx context.Context) ([]byte, error) {
+		return c.client.Get(ctx, c.workspace)
+	})
+	if err != nil {
+		return nil, err
+	}
+	if data == nil {
+		return nil, nil
+	}
+	sum := md5.Sum(data)
+	return &remote.Payload{MD5: sum[:], Data: data}, nil
+}
+
+func (c *RemoteClient) Put(ctx context.Context, data []byte) error {
+	// Fail closed if the lock is gone or its lease expired: another process
+	// may have taken over and written state since we read it.
+	if c.lockID != "" {
+		if err := withRetryNoResult(ctx, c.retryCfg, func(ctx context.Context) error {
+			return c.client.VerifyLock(ctx, c.workspace, c.lockID)
+		}); err != nil {
+			return fmt.Errorf("refusing to write state: this process no longer holds the state lock: %w", err)
+		}
+	}
+	// Retrying the whole Put could publish after the lease expired, unchecked.
+	if err := c.client.Put(ctx, c.workspace, data); err != nil {
+		return err
+	}
+	c.client.WaitForRetention()
+	return nil
+}
+
+// Delete is not retried: a retry re-resolves the workspace and could delete a newer writer's state.
+func (c *RemoteClient) Delete(ctx context.Context) error {
+	return c.client.Delete(ctx, c.workspace)
+}
+
+func (c *RemoteClient) Lock(ctx context.Context, info *statemgr.LockInfo) (string, error) {
+	shared := orasstate.LockInfo{}
+	if info != nil {
+		shared = orasstate.LockInfo{
+			ID:        info.ID,
+			Operation: info.Operation,
+			Info:      info.Info,
+			Who:       info.Who,
+			Version:   info.Version,
+			Created:   info.Created,
+			Path:      info.Path,
+		}
+	}
+
+	id, err := withRetry(ctx, c.retryCfg, func(ctx context.Context) (string, error) {
+		return c.client.Lock(ctx, c.workspace, shared)
+	})
+	if err == nil {
+		c.lockID = id
+		return id, nil
+	}
+
+	var lockErr *orasstate.LockError
+	if errors.As(err, &lockErr) {
+		var lockInfo *statemgr.LockInfo
+		if lockErr.Info != nil {
+			lockInfo = &statemgr.LockInfo{
+				ID:        lockErr.Info.ID,
+				Operation: lockErr.Info.Operation,
+				Info:      lockErr.Info.Info,
+				Who:       lockErr.Info.Who,
+				Version:   lockErr.Info.Version,
+				Created:   lockErr.Info.Created,
+				Path:      lockErr.Info.Path,
+			}
+		}
+		return "", &statemgr.LockError{Info: lockInfo, Err: lockErr.Err}
+	}
+	return "", err
+}
+
+func (c *RemoteClient) Unlock(ctx context.Context, id string) error {
+	if err := withRetryNoResult(ctx, c.retryCfg, func(ctx context.Context) error {
+		return c.client.Unlock(ctx, c.workspace, id)
+	}); err != nil {
+		return err
+	}
+	if id == c.lockID {
+		c.lockID = ""
+	}
+	return nil
+}
diff --git a/internal/backend/remote-state/oras/delete_retry_test.go b/internal/backend/remote-state/oras/delete_retry_test.go
new file mode 100644
index 000000000..a47915da1
--- /dev/null
+++ b/internal/backend/remote-state/oras/delete_retry_test.go
@@ -0,0 +1,70 @@
+package oras
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	orasstate "github.com/vmvarela/oras-state"
+)
+
+// A destructive delete must not be retried as a whole: a retry re-resolves the
+// workspace and could delete a newer writer's state. Every request the adapter
+// issues for one Delete must match a single library call.
+func TestDeleteIsNotRetriedAsAWhole(t *testing.T) {
+	t.Setenv("ORAS_TOKEN", "")
+	var requests atomic.Int64
+	// The server answers too slowly for the client timeout. The resulting net
+	// timeout is transient for isTransientError, so a whole-operation retry would
+	// re-issue the call. (A 503 is not used: its error type is not matched by
+	// isTransientError for this library.)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		requests.Add(1)
+		time.Sleep(200 * time.Millisecond)
+	}))
+	t.Cleanup(srv.Close)
+
+	newLibClient := func(t *testing.T) *orasstate.Client {
+		t.Helper()
+		c, err := orasstate.NewClient(strings.TrimPrefix(srv.URL, "http://"), "ns/state", orasstate.Config{
+			WorkspaceLayout: orasstate.WorkspaceLayoutLegacy,
+			PlainHTTP:       true,
+			HTTPClient:      &http.Client{Timeout: 30 * time.Millisecond},
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return c
+	}
+	retry := RetryConfig{MaxAttempts: 3, InitialBackoff: time.Millisecond, MaxBackoff: time.Millisecond, BackoffMultiplier: 2}
+	ctx := context.Background()
+
+	requests.Store(0)
+	_ = newLibClient(t).Delete(ctx, "ws")
+	baseline := requests.Load()
+	if baseline == 0 {
+		t.Fatal("library Delete issued no requests; the regression check would be vacuous")
+	}
+
+	t.Run("RemoteClient.Delete", func(t *testing.T) {
+		requests.Store(0)
+		rc := &RemoteClient{client: newLibClient(t), workspace: "ws", retryCfg: retry}
+		_ = rc.Delete(ctx)
+		if got := requests.Load(); got != baseline {
+			t.Fatalf("Delete issued %d requests, want %d (one library call)", got, baseline)
+		}
+	})
+
+	t.Run("Backend.DeleteWorkspace", func(t *testing.T) {
+		requests.Store(0)
+		b := &Backend{client: newLibClient(t), retryCfg: retry}
+		_ = b.DeleteWorkspace(ctx, "ws", false)
+		if got := requests.Load(); got != baseline {
+			t.Fatalf("DeleteWorkspace issued %d requests, want %d (one library call)", got, baseline)
+		}
+	})
+}
diff --git a/internal/backend/remote-state/oras/github_token.go b/internal/backend/remote-state/oras/github_token.go
new file mode 100644
index 000000000..f657980c0
--- /dev/null
+++ b/internal/backend/remote-state/oras/github_token.go
@@ -0,0 +1,84 @@
+package oras
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+	"sync"
+	"time"
+
+	orasAuth "oras.land/oras-go/v2/registry/remote/auth"
+)
+
+const ghcrRegistry = "ghcr.io"
+
+// ghAuthTokenTimeout bounds the gh CLI call. It is a variable so tests can shorten it.
+var ghAuthTokenTimeout = 10 * time.Second
+
+// githubTokenSource resolves a GitHub token for GHCR: GH_TOKEN, then GITHUB_TOKEN,
+// then `gh auth token`. The gh result is cached so retries do not re-run the CLI.
+type githubTokenSource struct {
+	mu       sync.Mutex
+	cliDone  bool
+	cliToken string
+	cliErr   error
+}
+
+// token returns "" and nil when no GitHub token is available. Errors never contain
+// token values or gh output.
+func (s *githubTokenSource) token(ctx context.Context) (string, error) {
+	for _, name := range []string{"GH_TOKEN", "GITHUB_TOKEN"} {
+		if t := strings.TrimSpace(os.Getenv(name)); t != "" {
+			return t, nil
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.cliDone {
+		s.cliToken, s.cliErr = ghAuthToken(ctx)
+		s.cliDone = true
+	}
+	return s.cliToken, s.cliErr
+}
+
+// ghAuthToken runs `gh auth token` non-interactively with a bounded timeout.
+// gh's stdin is /dev/null and its stderr is captured but never reported.
+func ghAuthToken(ctx context.Context) (string, error) {
+	exe, err := exec.LookPath("gh")
+	if err != nil {
+		return "", fmt.Errorf("gh CLI not found")
+	}
+
+	tctx, cancel := context.WithTimeout(ctx, ghAuthTokenTimeout)
+	defer cancel()
+	cmd := exec.CommandContext(tctx, exe, "auth", "token", "--hostname", "github.com")
+	cmd.Env = append(os.Environ(), "GH_PROMPT_DISABLED=1")
+	cmd.WaitDelay = time.Second
+	out, err := cmd.Output()
+	if errors.Is(tctx.Err(), context.DeadlineExceeded) {
+		return "", fmt.Errorf("gh auth token timed out after %s", ghAuthTokenTimeout)
+	}
+	if err != nil {
+		var exitErr *exec.ExitError
+		if errors.As(err, &exitErr) {
+			return "", fmt.Errorf("gh auth token failed with exit code %d", exitErr.ExitCode())
+		}
+		return "", fmt.Errorf("gh auth token could not run")
+	}
+
+	token := strings.TrimSpace(string(out))
+	if token == "" {
+		return "", fmt.Errorf("gh auth token returned no token")
+	}
+	return token, nil
+}
+
+// ghcrCredential uses basic auth so GHCR's token endpoint exchanges the token.
+// AccessToken is never set: GHCR rejects a raw Bearer token with 403.
+func ghcrCredential(token string) orasAuth.Credential {
+	// GHCR accepts any non-empty username with a token (Docker CLI convention).
+	return orasAuth.Credential{Username: "x", Password: token}
+}
diff --git a/internal/backend/remote-state/oras/github_token_test.go b/internal/backend/remote-state/oras/github_token_test.go
new file mode 100644
index 000000000..a30b3b066
--- /dev/null
+++ b/internal/backend/remote-state/oras/github_token_test.go
@@ -0,0 +1,218 @@
+package oras
+
+import (
+	"context"
+	"iter"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/opentofu/opentofu/internal/command/cliconfig/ociauthconfig"
+	orasAuth "oras.land/oras-go/v2/registry/remote/auth"
+)
+
+// fakeGH puts a fake gh script first on PATH; PATH is otherwise empty so the
+// real gh cannot be reached. It returns the directory holding the script.
+func fakeGH(t *testing.T, body string) string {
+	t.Helper()
+	dir := t.TempDir()
+	script := "#!/bin/sh\n" + body + "\n"
+	if err := os.WriteFile(filepath.Join(dir, "gh"), []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir)
+	return dir
+}
+
+func clearGitHubEnv(t *testing.T) {
+	t.Helper()
+	t.Setenv("GH_TOKEN", "")
+	t.Setenv("GITHUB_TOKEN", "")
+}
+
+func TestGitHubTokenPrecedence(t *testing.T) {
+	marker := filepath.Join(t.TempDir(), "gh-called")
+	tests := []struct {
+		name    string
+		ghToken string
+		gitTok  string
+		cliBody string
+		want    string
+		cliRan  bool
+	}{
+		{name: "GH_TOKEN wins", ghToken: "gh-token", gitTok: "github-token", want: "gh-token"},
+		{name: "blank GH_TOKEN falls to GITHUB_TOKEN", ghToken: "  ", gitTok: "github-token", want: "github-token"},
+		{name: "gh CLI used last, trimmed", want: "cli-token", cliBody: "printf 'cli-token\\n'", cliRan: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			clearGitHubEnv(t)
+			t.Setenv("GH_TOKEN", tc.ghToken)
+			t.Setenv("GITHUB_TOKEN", tc.gitTok)
+			fakeGH(t, "/usr/bin/touch "+marker+"\n"+tc.cliBody)
+			_ = os.Remove(marker)
+
+			got, err := (&githubTokenSource{}).token(context.Background())
+			if err != nil {
+				t.Fatalf("token() error = %v", err)
+			}
+			if got != tc.want {
+				t.Fatalf("token() = %q, want %q", got, tc.want)
+			}
+			_, statErr := os.Stat(marker)
+			if ran := statErr == nil; ran != tc.cliRan {
+				t.Fatalf("gh invoked = %v, want %v", ran, tc.cliRan)
+			}
+		})
+	}
+}
+
+func TestGitHubTokenNoneAvailable(t *testing.T) {
+	clearGitHubEnv(t)
+	t.Setenv("PATH", t.TempDir()) // no gh on PATH
+	got, err := (&githubTokenSource{}).token(context.Background())
+	if err == nil || got != "" {
+		t.Fatalf("token() = %q, %v; want empty token and gh-not-found error", got, err)
+	}
+}
+
+func TestGitHubTokenCLIErrorsDoNotDisclose(t *testing.T) {
+	const leak = "SECRET-SHOULD-NOT-APPEAR"
+	clearGitHubEnv(t)
+	fakeGH(t, "printf '"+leak+"' >&2\nprintf '"+leak+"'\nexit 4")
+	_, err := (&githubTokenSource{}).token(context.Background())
+	if err == nil {
+		t.Fatal("expected error from failing gh")
+	}
+	if !strings.Contains(err.Error(), "exit code 4") {
+		t.Fatalf("error = %q, want exit code", err)
+	}
+	if strings.Contains(err.Error(), leak) {
+		t.Fatalf("error leaked gh output: %q", err)
+	}
+}
+
+func TestGitHubTokenCLIEmptyOutput(t *testing.T) {
+	clearGitHubEnv(t)
+	fakeGH(t, "exit 0")
+	if _, err := (&githubTokenSource{}).token(context.Background()); err == nil || !strings.Contains(err.Error(), "no token") {
+		t.Fatalf("err = %v, want no-token error", err)
+	}
+}
+
+func TestGitHubTokenCLITimeoutIsBounded(t *testing.T) {
+	clearGitHubEnv(t)
+	prev := ghAuthTokenTimeout
+	ghAuthTokenTimeout = 100 * time.Millisecond
+	t.Cleanup(func() { ghAuthTokenTimeout = prev })
+	fakeGH(t, "exec /bin/sleep 30")
+
+	start := time.Now()
+	_, err := (&githubTokenSource{}).token(context.Background())
+	if err == nil || !strings.Contains(err.Error(), "timed out") {
+		t.Fatalf("err = %v, want timeout", err)
+	}
+	if elapsed := time.Since(start); elapsed > 10*time.Second {
+		t.Fatalf("gh call took %s, expected bounded", elapsed)
+	}
+}
+
+func TestGitHubTokenCLIIsCached(t *testing.T) {
+	clearGitHubEnv(t)
+	counter := filepath.Join(t.TempDir(), "calls")
+	fakeGH(t, "printf x >> "+counter+"\nprintf 'cli-token'")
+	src := &githubTokenSource{}
+	for range 3 {
+		if got, err := src.token(context.Background()); err != nil || got != "cli-token" {
+			t.Fatalf("token() = %q, %v", got, err)
+		}
+	}
+	data, err := os.ReadFile(counter)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(data) != 1 {
+		t.Fatalf("gh ran %d times, want 1", len(data))
+	}
+}
+
+// staticConfig supplies Docker-style credentials for one registry, standing in for
+// ~/.docker/config.json.
+type staticConfig struct {
+	registry string
+	creds    ociauthconfig.Credentials
+}
+
+func (c staticConfig) CredentialsSourcesForRepository(_ context.Context, registryDomain, _ string) iter.Seq2[ociauthconfig.CredentialsSource, error] {
+	return func(yield func(ociauthconfig.CredentialsSource, error) bool) {
+		if registryDomain == c.registry {
+			yield(ociauthconfig.NewStaticCredentialsSource(c.creds, ociauthconfig.DomainCredentialsSpecificity), nil)
+		}
+	}
+}
+
+func (c staticConfig) CredentialsConfigLocationForUI() string { return "test" }
+
+func credentialFuncFor(t *testing.T, repository string, cfgs ...ociauthconfig.CredentialsConfig) credentialFunc {
+	t.Helper()
+	fn, err := realORASCredentialsPolicy{policy: ociauthconfig.NewCredentialsConfigs(cfgs)}.CredentialFunc(context.Background(), repository)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return fn
+}
+
+func TestGHCRCredentialFuncPrecedenceAndFallback(t *testing.T) {
+	docker := staticConfig{registry: "ghcr.io", creds: ociauthconfig.NewBasicAuthCredentials("docker-user", "docker-pass")}
+
+	t.Run("GH_TOKEN is exchanged as basic auth, never AccessToken", func(t *testing.T) {
+		clearGitHubEnv(t)
+		t.Setenv("GH_TOKEN", "gh-token")
+		cred, err := credentialFuncFor(t, "ghcr.io/org/state", docker)(context.Background(), "")
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := orasAuth.Credential{Username: "x", Password: "gh-token"}
+		if cred != want {
+			t.Fatalf("cred = %+v, want %+v", cred, want)
+		}
+	})
+
+	t.Run("gh failure falls back to Docker credentials", func(t *testing.T) {
+		clearGitHubEnv(t)
+		fakeGH(t, "exit 1")
+		cred, err := credentialFuncFor(t, "ghcr.io/org/state", docker)(context.Background(), "")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if cred.Username != "docker-user" || cred.Password != "docker-pass" {
+			t.Fatalf("cred = %+v, want docker fallback", cred)
+		}
+	})
+
+	t.Run("no GitHub token and no Docker credentials is anonymous", func(t *testing.T) {
+		clearGitHubEnv(t)
+		t.Setenv("PATH", t.TempDir())
+		cred, err := credentialFuncFor(t, "ghcr.io/org/state")(context.Background(), "")
+		if err != nil {
+			t.Fatalf("err = %v, want anonymous", err)
+		}
+		if cred != orasAuth.EmptyCredential {
+			t.Fatalf("cred = %+v, want empty", cred)
+		}
+	})
+
+	t.Run("GitHub token is never sent to other registries", func(t *testing.T) {
+		clearGitHubEnv(t)
+		t.Setenv("GH_TOKEN", "gh-token")
+		cred, err := credentialFuncFor(t, "registry.example.com/org/state")(context.Background(), "")
+		if err != nil {
+			t.Fatalf("err = %v, want anonymous", err)
+		}
+		if cred != orasAuth.EmptyCredential {
+			t.Fatalf("GitHub token leaked to non-GHCR registry: %+v", cred)
+		}
+	})
+}
diff --git a/internal/backend/remote-state/oras/repository_source.go b/internal/backend/remote-state/oras/repository_source.go
new file mode 100644
index 000000000..703573d7c
--- /dev/null
+++ b/internal/backend/remote-state/oras/repository_source.go
@@ -0,0 +1,105 @@
+package oras
+
+import (
+	"reflect"
+	"strings"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hclsyntax"
+	"github.com/zclconf/go-cty/cty"
+)
+
+var repositorySchema = &hcl.BodySchema{Attributes: []hcl.AttributeSchema{{Name: "repository"}}}
+
+var hclsyntaxPkgPath = reflect.TypeOf(hclsyntax.LiteralValueExpr{}).PkgPath()
+
+// CheckLiteralRepository requires repository to be a plain string literal in the
+// backend block and forbids -backend-config from setting it. backendBlock is the
+// configured block body; override is the merged -backend-config body, or nil.
+// Variables, locals, functions, conditionals, and null are rejected, because
+// OpenTofu may evaluate them from TF_VAR_* or other context.
+func CheckLiteralRepository(backendBlock, override hcl.Body) hcl.Diagnostics {
+	if backendBlock == nil {
+		return hcl.Diagnostics{{
+			Severity: hcl.DiagError,
+			Summary:  "Missing backend block",
+			Detail:   `backend "oras" must be declared with repository set in the backend block.`,
+		}}
+	}
+	content, _, diags := backendBlock.PartialContent(repositorySchema)
+	if diags.HasErrors() {
+		return diags
+	}
+	attr, ok := content.Attributes["repository"]
+	if !ok {
+		return hcl.Diagnostics{{
+			Severity: hcl.DiagError,
+			Summary:  "Missing repository",
+			Detail:   `backend "oras" requires repository to be set literally in the backend block. Environment variables and -backend-config cannot provide it.`,
+		}}
+	}
+	if !isLiteralRepository(attr.Expr) {
+		return hcl.Diagnostics{{
+			Severity: hcl.DiagError,
+			Summary:  "repository must be a literal string",
+			Detail:   `backend "oras" requires repository to be a plain string literal in the backend block. Variables, locals, functions, and null are not allowed.`,
+			Subject:  attr.Expr.Range().Ptr(),
+		}}
+	}
+	if override == nil {
+		return nil
+	}
+	overrideContent, _, diags := override.PartialContent(repositorySchema)
+	if diags.HasErrors() {
+		return diags
+	}
+	if attr, ok := overrideContent.Attributes["repository"]; ok {
+		return hcl.Diagnostics{{
+			Severity: hcl.DiagError,
+			Summary:  "repository must come from the backend block",
+			Detail:   `-backend-config cannot set repository for backend "oras"; set it in the backend block.`,
+			Subject:  attr.Range.Ptr(),
+		}}
+	}
+	return nil
+}
+
+// isLiteralRepository accepts only a string literal written in the configuration.
+// Native HCL syntax must be a plain literal. Other syntaxes (JSON) return string
+// values verbatim when evaluated without context, while OpenTofu evaluates "${...}"
+// and "%{...}" in them. So a JSON value containing a template opener is rejected,
+// even one that looks like a function call, and so is any escaped form.
+func isLiteralRepository(expr hcl.Expression) bool {
+	if expr == nil {
+		return false
+	}
+	if reflect.TypeOf(expr).Elem().PkgPath() == hclsyntaxPkgPath {
+		switch e := expr.(type) {
+		case *hclsyntax.TemplateExpr:
+			if len(e.Parts) == 0 {
+				return true // the empty string literal
+			}
+			return len(e.Parts) == 1 && isLiteralString(e.Parts[0])
+		case *hclsyntax.LiteralValueExpr:
+			return isLiteralString(e)
+		}
+		return false
+	}
+	if len(expr.Variables()) != 0 {
+		return false
+	}
+	v, diags := expr.Value(nil)
+	if diags.HasErrors() || v.Type() != cty.String || !v.IsKnown() || v.IsNull() {
+		return false
+	}
+	s := v.AsString()
+	return !strings.Contains(s, "${") && !strings.Contains(s, "%{")
+}
+
+func isLiteralString(expr hcl.Expression) bool {
+	lit, ok := expr.(*hclsyntax.LiteralValueExpr)
+	if !ok {
+		return false
+	}
+	return lit.Val.Type() == cty.String && lit.Val.IsKnown() && !lit.Val.IsNull()
+}
diff --git a/internal/backend/remote-state/oras/repository_source_test.go b/internal/backend/remote-state/oras/repository_source_test.go
new file mode 100644
index 000000000..0970a4c4f
--- /dev/null
+++ b/internal/backend/remote-state/oras/repository_source_test.go
@@ -0,0 +1,95 @@
+package oras
+
+import (
+	"testing"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hclsyntax"
+	hcljson "github.com/hashicorp/hcl/v2/json"
+)
+
+func parseBody(t *testing.T, src string) hcl.Body {
+	t.Helper()
+	f, diags := hclsyntax.ParseConfig([]byte(src), "backend.tf", hcl.InitialPos)
+	if diags.HasErrors() {
+		t.Fatal(diags)
+	}
+	return f.Body
+}
+
+func parseJSONBody(t *testing.T, src string) hcl.Body {
+	t.Helper()
+	f, diags := hcljson.Parse([]byte(src), "backend.tf.json")
+	if diags.HasErrors() {
+		t.Fatal(diags)
+	}
+	return f.Body
+}
+
+// JSON strings are returned verbatim without a context, so the check must reject
+// any template opener, not only variables and functions.
+func TestCheckLiteralRepositoryJSON(t *testing.T) {
+	tests := []struct {
+		name    string
+		json    string
+		wantErr bool
+	}{
+		{"plain literal", `{"repository": "ghcr.io/org/state"}`, false},
+		{"trailing dollar is not a template", `{"repository": "ghcr.io/org/state$"}`, false},
+		{"file() interpolation", `{"repository": "${file(\"repo.txt\")}"}`, true},
+		{"variable interpolation", `{"repository": "${var.repo}"}`, true},
+		{"local interpolation", `{"repository": "${local.repo}"}`, true},
+		{"template directive", `{"repository": "%{ if true }ghcr.io/a/b%{ endif }"}`, true},
+		{"escaped interpolation", `{"repository": "$${literal}"}`, true},
+		{"null", `{"repository": null}`, true},
+		{"number", `{"repository": 7}`, true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			diags := CheckLiteralRepository(parseJSONBody(t, tc.json), nil)
+			if diags.HasErrors() != tc.wantErr {
+				t.Fatalf("errors = %v, wantErr %v", diags, tc.wantErr)
+			}
+		})
+	}
+}
+
+func TestCheckLiteralRepository(t *testing.T) {
+	literal := parseBody(t, `repository = "ghcr.io/org/state"`)
+	heredoc := parseBody(t, "repository = <<EOT\nghcr.io/org/state\nEOT\n")
+	noRepo := parseBody(t, `insecure = false`)
+	overrideRepo := parseBody(t, `repository = "ghcr.io/other/state"`)
+	overrideOther := parseBody(t, `compression = "gzip"`)
+
+	tests := []struct {
+		name     string
+		block    hcl.Body
+		override hcl.Body
+		wantErr  bool
+	}{
+		{"literal repository, no override", literal, nil, false},
+		{"literal heredoc repository", heredoc, nil, false},
+		{"literal repository, unrelated override", literal, overrideOther, false},
+		{"repository missing from block", noRepo, nil, true},
+		{"repository only in override", noRepo, overrideRepo, true},
+		{"override replaces literal repository", literal, overrideRepo, true},
+		{"nil block", nil, nil, true},
+		{"variable reference", parseBody(t, `repository = var.repo`), nil, true},
+		{"local reference", parseBody(t, `repository = local.repo`), nil, true},
+		{"function call", parseBody(t, `repository = lower("GHCR.io/org/state")`), nil, true},
+		{"file() call", parseBody(t, `repository = file("repo.txt")`), nil, true},
+		{"null", parseBody(t, `repository = null`), nil, true},
+		{"interpolation of literal", parseBody(t, `repository = "${"ghcr.io/org/state"}"`), nil, true},
+		{"interpolated variable", parseBody(t, `repository = "ghcr.io/${var.org}/state"`), nil, true},
+		{"conditional", parseBody(t, `repository = true ? "ghcr.io/a/b" : "ghcr.io/c/d"`), nil, true},
+		{"number", parseBody(t, `repository = 42`), nil, true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			diags := CheckLiteralRepository(tc.block, tc.override)
+			if diags.HasErrors() != tc.wantErr {
+				t.Fatalf("errors = %v, wantErr %v", diags, tc.wantErr)
+			}
+		})
+	}
+}
