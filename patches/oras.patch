diff --git a/internal/backend/remote-state/oras/assistant.go b/internal/backend/remote-state/oras/assistant.go
new file mode 100644
index 000000000..90f38b718
--- /dev/null
+++ b/internal/backend/remote-state/oras/assistant.go
@@ -0,0 +1,87 @@
+package oras
+
+import (
+	"fmt"
+	"net/url"
+	"strings"
+
+	orasRegistry "oras.land/oras-go/v2/registry"
+)
+
+// InferRepository derives a GHCR state repository from a GitHub origin URL and
+// the module's path inside the repository. Only origin URLs whose host is
+// exactly github.com are recognized.
+func InferRepository(origin, modulePrefix string) (string, bool) {
+	origin = strings.TrimSpace(origin)
+	if origin == "" {
+		return "", false
+	}
+
+	var host, repositoryPath string
+	if strings.HasPrefix(origin, "git@") {
+		rest := strings.TrimPrefix(origin, "git@")
+		index := strings.IndexByte(rest, ':')
+		if index < 0 {
+			return "", false
+		}
+		host, repositoryPath = rest[:index], rest[index+1:]
+	} else {
+		parsed, err := url.Parse(origin)
+		if err != nil {
+			return "", false
+		}
+		switch parsed.Scheme {
+		case "https":
+			if parsed.User != nil {
+				return "", false
+			}
+		case "ssh":
+			if parsed.User == nil || parsed.User.Username() != "git" {
+				return "", false
+			}
+		default:
+			return "", false
+		}
+		host, repositoryPath = parsed.Hostname(), parsed.Path
+	}
+	if !strings.EqualFold(host, "github.com") {
+		return "", false
+	}
+
+	repositoryPath = strings.Trim(strings.TrimSuffix(strings.Trim(repositoryPath, "/"), ".git"), "/")
+	parts := strings.Split(repositoryPath, "/")
+	if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
+		return "", false
+	}
+
+	repository := fmt.Sprintf("ghcr.io/%s/%s-tfstate", strings.ToLower(parts[0]), strings.ToLower(parts[1]))
+	if prefix := strings.ToLower(strings.Trim(strings.ReplaceAll(modulePrefix, "\\", "/"), "/")); prefix != "" {
+		repository += "/" + prefix
+	}
+	if err := ValidateRepository(repository); err != nil {
+		return "", false
+	}
+	return repository, true
+}
+
+// ValidateRepository accepts an OCI repository reference without a tag or digest.
+func ValidateRepository(repository string) error {
+	_, err := parseRepository(repository)
+	return err
+}
+
+func parseRepository(repository string) (orasRegistry.Reference, error) {
+	ref, err := orasRegistry.ParseReference(repository)
+	if err != nil {
+		return ref, err
+	}
+	// ParseReference accepts empty tag and digest suffixes such as "state:"
+	// and "state@". A colon after the last slash starts a tag; any @ starts a
+	// digest. Reject both while leaving registry ports, which precede the
+	// first slash, alone.
+	if ref.Reference != "" || strings.Contains(repository, "@") ||
+		strings.LastIndexByte(repository, ':') > strings.LastIndexByte(repository, '/') {
+		return ref, fmt.Errorf("repository must not include a tag or digest")
+	}
+	return ref, nil
+}
