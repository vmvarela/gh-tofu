+type recordingInitView struct {
+	views.Init
+	diagnostics []tfdiags.Diagnostics
+}
+
+func (v *recordingInitView) Diagnostics(diags tfdiags.Diagnostics) {
+	v.diagnostics = append(v.diagnostics, diags)
+}
+
+func TestORASSetupAllowed(t *testing.T) {
+	newArgs := func() *arguments.Init {
+		return &arguments.Init{
+			View:            &arguments.View{ViewType: arguments.ViewHuman},
+			Backend:         &arguments.Backend{},
+			FlagBackend:     true,
+			FlagConfigExtra: flags.NewRawFlags("-backend-config"),
+		}
+	}
+
+	tests := []struct {
+		name       string
+		mutate     func(*arguments.Init)
+		input      bool
+		stdinPiped bool
+		automation bool
+		want       bool
+	}{
+		{"interactive human", func(*arguments.Init) {}, true, false, false, true},
+		{"json output", func(a *arguments.Init) { a.View.ViewType = arguments.ViewJSON }, true, false, false, false},
+		{"input disabled", func(*arguments.Init) {}, false, false, false, false},
+		{"stdin piped", func(*arguments.Init) {}, true, true, false, false},
+		{"automation", func(*arguments.Init) {}, true, false, true, false},
+		{"backend disabled", func(a *arguments.Init) { a.FlagBackend = false }, true, false, false, false},
+		{"backend config", func(a *arguments.Init) { _ = a.FlagConfigExtra.Set("x.hcl") }, true, false, false, false},
+		{"force copy", func(a *arguments.Init) { a.Backend.ForceInitCopy = true }, true, false, false, false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			args := newArgs()
+			tc.mutate(args)
+			if got := orasSetupAllowed(args, tc.input, tc.stdinPiped, tc.automation); got != tc.want {
+				t.Fatalf("orasSetupAllowed() = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestORASRepositoryPrompt(t *testing.T) {
+	inferred := orasRepositoryPrompt("ghcr.io/org/repo-tfstate")
+	if inferred.Default != "ghcr.io/org/repo-tfstate" || !strings.Contains(inferred.Description, "Press Enter") {
+		t.Fatalf("unexpected inferred prompt: %#v", inferred)
+	}
+	if got := orasRepositoryPrompt(""); got.Default != "" || strings.Contains(got.Description, "Press Enter") {
+		t.Fatalf("unexpected empty prompt: %#v", got)
+	}
+}
+
+func TestWriteORASBackendConfigDoesNotOverwrite(t *testing.T) {
+	dir := t.TempDir()
+	for _, name := range []string{"backend.tf", "backend.gh-tofu.tf", "backend.gh-tofu-2.tf"} {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte("existing\n"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	path, err := writeORASBackendConfig(dir, "ghcr.io/org/state")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := filepath.Join(dir, "backend.gh-tofu-3.tf"); path != want {
+		t.Fatalf("wrote %s, want %s", path, want)
+	}
+	content, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(content), `repository = "ghcr.io/org/state"`) {
+		t.Fatalf("unexpected generated content: %s", content)
+	}
+	if existing, _ := os.ReadFile(filepath.Join(dir, "backend.tf")); string(existing) != "existing\n" {
+		t.Fatalf("existing backend.tf was changed: %s", existing)
+	}
+
+	second, err := writeORASBackendConfig(dir, "ghcr.io/org/state")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := filepath.Join(dir, "backend.gh-tofu-4.tf"); second != want {
+		t.Fatalf("second write used %s, want %s", second, want)
+	}
+}
+
+func TestGeneratedORASConfigWarning(t *testing.T) {
+	if got := generatedORASConfigWarning("backend.tf", 0); len(got) != 0 {
+		t.Fatalf("success returned warnings: %#v", got)
+	}
+	if got := generatedORASConfigWarning("", 1); len(got) != 0 {
+		t.Fatalf("missing path returned warnings: %#v", got)
+	}
+	got := generatedORASConfigWarning("backend.tf", 1)
+	if len(got) != 1 {
+		t.Fatalf("failure returned %d diagnostics, want 1", len(got))
+	}
+	description := got[0].Description()
+	if description.Summary != "Generated ORAS backend configuration was kept" ||
+		!strings.Contains(description.Detail, "backend.tf") {
+		t.Fatalf("unexpected warning: %#v", description)
+	}
+}
+
+func TestEmitGeneratedORASConfigWarning(t *testing.T) {
+	tests := []struct {
+		name string
+		path string
+		code int
+		want int
+	}{
+		{"success", "backend.tf", 0, 0},
+		{"no generated file", "", 1, 0},
+		{"failure", "backend.tf", 1, 1},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			view := &recordingInitView{}
+			emitGeneratedORASConfigWarning(view, tc.path, tc.code)
+			if len(view.diagnostics) != tc.want {
+				t.Fatalf("emitted %d diagnostic sets, want %d", len(view.diagnostics), tc.want)
+			}
+			if tc.want == 1 && len(view.diagnostics[0]) != 1 {
+				t.Fatalf("emitted %d diagnostics, want 1", len(view.diagnostics[0]))
+			}
+		})
+	}
+}
+
+func TestGeneratedORASConfigWarningRegisteredBeforeSetupReturns(t *testing.T) {
+	source, err := os.ReadFile("init.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(source)
+	deferAt := strings.Index(text, "emitGeneratedORASConfigWarning(view, generatedORASConfig, code)")
+	setupAt := strings.Index(text, "c.maybeSetupORASBackend(ctx, path, rootModEarly)")
+	setupErrorAt := strings.Index(text, "if setupDiags.HasErrors() {")
+	reloadAt := strings.LastIndex(text, "c.loadSingleModuleWithTests(ctx, path, args.TestsDirectory)")
+	if deferAt < 0 || setupAt < 0 || setupErrorAt < 0 || reloadAt < 0 {
+		t.Fatalf("could not find the setup sequence: defer=%d setup=%d error=%d reload=%d", deferAt, setupAt, setupErrorAt, reloadAt)
+	}
+	if deferAt > setupErrorAt || deferAt > reloadAt {
+		t.Fatalf("warning defer is registered too late: defer=%d error=%d reload=%d", deferAt, setupErrorAt, reloadAt)
+	}
+}
+
+func TestMaybeSetupORASBackendDeclineKeepsState(t *testing.T) {
+	dir := t.TempDir()
+	writeTestFile(t, filepath.Join(dir, "main.tf"), "terraform {}\n")
+	statePath := filepath.Join(dir, "terraform.tfstate")
+	state := []byte(`{"version":4,"serial":1}`)
+	if err := os.WriteFile(statePath, state, 0o600); err != nil {
+		t.Fatal(err)
