diff --git a/internal/command/init_oras_assistant.go b/internal/command/init_oras_assistant.go
new file mode 100644
index 000000000..d3f084907
--- /dev/null
+++ b/internal/command/init_oras_assistant.go
@@ -0,0 +1,169 @@
+package command
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+
+	backendORAS "github.com/opentofu/opentofu/internal/backend/remote-state/oras"
+	"github.com/opentofu/opentofu/internal/command/arguments"
+	"github.com/opentofu/opentofu/internal/command/views"
+	"github.com/opentofu/opentofu/internal/configs"
+	"github.com/opentofu/opentofu/internal/tfdiags"
+	"github.com/opentofu/opentofu/internal/tofu"
+)
+
+// orasSetupAllowed reports whether the first-run ORAS backend assistant may
+// run. It is limited to human interactive init calls and skips every case where
+// prompting or writing a configuration file would be surprising.
+func orasSetupAllowed(args *arguments.Init, input, stdinPiped, automation bool) bool {
+	return args.FlagBackend &&
+		args.View.ViewType == arguments.ViewHuman &&
+		input && !stdinPiped && !automation &&
+		len(args.FlagConfigExtra.AllItems()) == 0 &&
+		!args.Backend.ForceInitCopy
+}
+
+// maybeSetupORASBackend offers the ORAS backend when the root module has no
+// backend or cloud block. It returns the path of a generated configuration file,
+// or an empty string when the user declined.
+func (c *InitCommand) maybeSetupORASBackend(ctx context.Context, dir string, root *configs.Module) (string, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if root.Backend != nil || root.CloudConfig != nil {
+		return "", diags
+	}
+
+	inferred := ""
+	if origin, ok := gitRemoteOrigin(ctx, dir); ok {
+		prefix := ""
+		if value, ok := gitModulePrefix(ctx, dir); ok {
+			prefix = value
+		}
+		inferred, _ = backendORAS.InferRepository(origin, prefix)
+	}
+
+	answer, err := c.UIInput().Input(ctx, &tofu.InputOpts{
+		Id:          "oras-backend-setup",
+		Query:       "Set up the gh-tofu ORAS backend?",
+		Description: "No backend is configured. gh-tofu can store state in GitHub Container Registry (GHCR).\n\nOpenTofu migrates any existing local state with its normal confirmation prompt.",
+		Default:     "no",
+	})
+	if err != nil {
+		diags = diags.Append(tfdiags.Sourceless(tfdiags.Error, "Failed to read the ORAS backend setup answer", err.Error()))
+		return "", diags
+	}
+	switch strings.ToLower(strings.TrimSpace(answer)) {
+	case "yes", "y":
+	default:
+		return "", diags
+	}
+
+	location, err := c.UIInput().Input(ctx, orasRepositoryPrompt(inferred))
+	if err != nil {
+		diags = diags.Append(tfdiags.Sourceless(tfdiags.Error, "Failed to read the ORAS repository", err.Error()))
+		return "", diags
+	}
+	location = strings.TrimSpace(location)
+	if location == "" {
+		diags = diags.Append(tfdiags.Sourceless(tfdiags.Error, "Invalid ORAS repository",
+			"No repository was entered. Enter <registry>/<repository> without a tag or digest."))
+		return "", diags
+	}
+	if err := backendORAS.ValidateRepository(location); err != nil {
+		diags = diags.Append(tfdiags.Sourceless(tfdiags.Error, "Invalid ORAS repository",
+			fmt.Sprintf("%q is not a valid OCI repository: %s", location, err)))
+		return "", diags
+	}
+
+	path, err := writeORASBackendConfig(dir, location)
+	if err != nil {
+		diags = diags.Append(tfdiags.Sourceless(tfdiags.Error, "Could not write the ORAS backend configuration", err.Error()))
+		return "", diags
+	}
+	return path, diags
+}
+
+func orasRepositoryPrompt(inferred string) *tofu.InputOpts {
+	description := "Enter <registry>/<repository> without a tag or digest."
+	if inferred != "" {
+		description = "Press Enter to accept the suggested repository, or edit it.\nThe repository must not include a tag or digest."
+	}
+	return &tofu.InputOpts{
+		Id:          "oras-backend-repository",
+		Query:       "ORAS backend repository",
+		Description: description,
+		Default:     inferred,
+	}
+}
+
+// writeORASBackendConfig creates a new backend configuration file without
+// overwriting any existing file, trying deterministic names in order.
+func writeORASBackendConfig(dir, repository string) (string, error) {
+	for i := 0; ; i++ {
+		name := "backend.tf"
+		switch {
+		case i == 1:
+			name = "backend.gh-tofu.tf"
+		case i > 1:
+			name = fmt.Sprintf("backend.gh-tofu-%d.tf", i)
+		}
+		path := filepath.Join(dir, name)
+		file, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o644)
+		if errors.Is(err, fs.ErrExist) {
+			continue
+		}
+		if err != nil {
+			return "", err
+		}
+		_, writeErr := fmt.Fprintf(file, "terraform {\n  backend \"oras\" {\n    repository = %q\n  }\n}\n", repository)
+		closeErr := file.Close()
+		if writeErr != nil || closeErr != nil {
+			_ = os.Remove(path)
+			if writeErr != nil {
+				return "", writeErr
+			}
+			return "", closeErr
+		}
+		return path, nil
+	}
+}
+
+func gitRemoteOrigin(ctx context.Context, dir string) (string, bool) {
+	out, err := exec.CommandContext(ctx, "git", "-C", dir, "remote", "get-url", "origin").Output()
+	if err != nil {
+		return "", false
+	}
+	return strings.TrimSpace(string(out)), true
+}
+
+func gitModulePrefix(ctx context.Context, dir string) (string, bool) {
+	out, err := exec.CommandContext(ctx, "git", "-C", dir, "rev-parse", "--show-prefix").Output()
+	if err != nil {
+		return "", false
+	}
+	return strings.TrimSpace(string(out)), true
+}
+
+func orasConfigKeptWarning(path string) tfdiags.Diagnostic {
+	return tfdiags.Sourceless(tfdiags.Warning,
+		"Generated ORAS backend configuration was kept",
+		fmt.Sprintf("Initialization did not complete, but %s was kept. Fix the error above and run \"gh tofu init\" again. OpenTofu handles state migration and confirmation natively.", path))
+}
+
+func generatedORASConfigWarning(path string, code int) tfdiags.Diagnostics {
+	if path == "" || code == 0 {
+		return nil
+	}
+	return tfdiags.Diagnostics{orasConfigKeptWarning(path)}
+}
+
+func emitGeneratedORASConfigWarning(view views.Init, path string, code int) {
+	if warning := generatedORASConfigWarning(path, code); len(warning) != 0 {
+		view.Diagnostics(warning)
+	}
+}
