+package oras
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hcldec"
+)
+
+// The repository must come from HCL: an environment variable must not satisfy it.
+func TestRepositoryRequiresHCLNotEnv(t *testing.T) {
+	t.Setenv("TF_BACKEND_ORAS_REPOSITORY", "ghcr.io/org/state")
+
+	b := New(nil).(*Backend)
+	if attr := b.ConfigSchema().Attributes["repository"]; attr == nil || !attr.Required {
+		t.Fatal("repository must be a required HCL argument")
+	}
+
+	_, diags := hcldec.Decode(hcl.EmptyBody(), b.ConfigSchema().DecoderSpec(), nil)
+	if !diags.HasErrors() || !strings.Contains(diags.Error(), "repository") {
+		t.Fatalf("empty backend block with env var set: diags = %v, want missing repository argument", diags)
+	}
+}
diff --git a/internal/backend/remote-state/oras/retry.go b/internal/backend/remote-state/oras/retry.go
new file mode 100644
index 000000000..33c9cde62
--- /dev/null
+++ b/internal/backend/remote-state/oras/retry.go
@@ -0,0 +1,97 @@
+package oras
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+
+	orasErrcode "oras.land/oras-go/v2/registry/remote/errcode"
+)
+
+type RetryConfig struct {
+	MaxAttempts       int
+	InitialBackoff    time.Duration
+	MaxBackoff        time.Duration
+	BackoffMultiplier float64
+}
+
+func withRetry[T any](ctx context.Context, cfg RetryConfig, operation func(context.Context) (T, error)) (T, error) {
+	var zero T
+	var lastErr error
+	if cfg.MaxAttempts <= 0 {
+		cfg.MaxAttempts = 1
+	}
+	backoff := cfg.InitialBackoff
+	if backoff <= 0 {
+		backoff = time.Second
+	}
+
+	for attempt := 1; attempt <= cfg.MaxAttempts; attempt++ {
+		result, err := operation(ctx)
+		if err == nil {
+			return result, nil
+		}
+		lastErr = err
+		if ctx.Err() != nil {
+			return zero, ctx.Err()
+		}
+		if !isTransientError(err) {
+			return zero, err
+		}
+		if attempt == cfg.MaxAttempts {
+			break
+		}
+		select {
+		case <-ctx.Done():
+			return zero, ctx.Err()
+		case <-time.After(backoff):
+		}
+		backoff = time.Duration(float64(backoff) * cfg.BackoffMultiplier)
+		if cfg.MaxBackoff > 0 && backoff > cfg.MaxBackoff {
+			backoff = cfg.MaxBackoff
+		}
+	}
+	return zero, lastErr
+}
+
+func withRetryNoResult(ctx context.Context, cfg RetryConfig, operation func(context.Context) error) error {
+	_, err := withRetry(ctx, cfg, func(ctx context.Context) (struct{}, error) {
+		return struct{}{}, operation(ctx)
+	})
+	return err
+}
+
+func isTransientError(err error) bool {
+	if err == nil {
+		return false
+	}
+	var errResp *orasErrcode.ErrorResponse
+	if errors.As(err, &errResp) {
+		switch errResp.StatusCode {
+		case http.StatusTooManyRequests, http.StatusRequestTimeout, http.StatusBadGateway,
+			http.StatusServiceUnavailable, http.StatusGatewayTimeout:
+			return true
+		default:
+			return false
+		}
+	}
+	var netErr net.Error
+	if errors.As(err, &netErr) {
+		return netErr.Timeout()
+	}
+	msg := strings.ToLower(err.Error())
+	return strings.Contains(msg, "connection reset") ||
+		strings.Contains(msg, "connection refused") ||
+		strings.Contains(msg, "i/o timeout") ||
+		strings.Contains(msg, "connection timeout") ||
+		strings.Contains(msg, "tls handshake timeout") ||
+		strings.Contains(msg, "context deadline exceeded") ||
+		strings.Contains(msg, "temporary failure in name resolution") ||
+		strings.Contains(msg, "no such host") ||
+		strings.Contains(msg, "unexpected eof") ||
+		strings.Contains(msg, "read: eof") ||
+		msg == "eof"
+}
diff --git a/internal/backend/remote-state/oras/transport.go b/internal/backend/remote-state/oras/transport.go
new file mode 100644
index 000000000..15f1f4535
--- /dev/null
+++ b/internal/backend/remote-state/oras/transport.go
@@ -0,0 +1,168 @@
+package oras
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"regexp"
+	"strings"
+
+	orasstate "github.com/vmvarela/oras-state"
+	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
+	"golang.org/x/time/rate"
+)
+
+// rejectInsecureGHCR refuses insecure transport for GHCR, where it would expose
+// GitHub credentials to plain HTTP or to an unverified TLS peer.
+func rejectInsecureGHCR(registry string, insecure bool) error {
+	if insecure && strings.EqualFold(registry, ghcrRegistry) {
+		return fmt.Errorf("insecure must be false for %s: GitHub credentials are never sent over plain HTTP or unverified TLS", ghcrRegistry)
+	}
+	return nil
+}
+
+func newHTTPClient(registry string, insecure bool, caFile string, rateLimit, rateBurst int) (*http.Client, error) {
+	client, err := orasstate.BuildHTTPClient(insecure, caFile)
+	if err != nil {
+		return nil, err
+	}
+
+	var rt http.RoundTripper = client.Transport
+	if rateLimit > 0 {
+		burst := rateBurst
+		if burst <= 0 {
+			burst = 1
+		}
+		rt = &rateLimitedRoundTripper{
+			limiter: rate.NewLimiter(rate.Limit(rateLimit), burst),
+			inner:   rt,
+		}
+	}
+	guard := &credentialGuard{
+		inner:    otelhttp.NewTransport(rt),
+		registry: strings.ToLower(registry),
+		insecure: insecure,
+	}
+	if strings.EqualFold(registry, ghcrRegistry) {
+		guard.ghcr = &ghcrEndpoints{tokenHost: ghcrRegistry, apiHost: ghcrAPIHost}
+	}
+	client.Transport = guard
+	return client, nil
+}
+
+// ghcrAPIHost serves the GitHub Packages API used by GHCR tag deletion.
+const ghcrAPIHost = "api.github.com"
+
+// ghcrEndpoints are the only destinations that may receive GitHub credentials
+// for GHCR. Token and registry requests go to tokenHost; version listing and
+// deletion go to apiHost. Tests substitute local hosts.
+type ghcrEndpoints struct {
+	tokenHost string
+	apiHost   string
+}
+
+var (
+	ghcrPackageVersionsPath = regexp.MustCompile(`^/(orgs|users)/[^/]+/packages/container/[^/]+/versions$`)
+	ghcrPackageVersionPath  = regexp.MustCompile(`^/(orgs|users)/[^/]+/packages/container/[^/]+/versions/[0-9]+$`)
+)
+
+// credentialGuard refuses to send credentials to a destination that is not an
+// intended one. oras-go follows the registry's bearer realm, and sends
+// credentials either as an Authorization header or, for an OAuth2 token request,
+// as a form body with no header. With TLS verification skipped, an attacker could
+// name their own realm. The guard checks every request and every redirect hop.
+type credentialGuard struct {
+	inner    http.RoundTripper
+	registry string // lowercase host[:port] of the state registry
+	insecure bool
+	ghcr     *ghcrEndpoints // nil unless the registry is GHCR
+}
+
+func (g *credentialGuard) RoundTrip(req *http.Request) (*http.Response, error) {
+	if credentialRequest(req) {
+		if err := g.checkDestination(req); err != nil {
+			return nil, err
+		}
+	}
+	return g.inner.RoundTrip(req)
+}
+
+// credentialRequest reports whether req carries credentials.
+func credentialRequest(req *http.Request) bool {
+	return req.Header.Get("Authorization") != "" || isFormBody(req)
+}
+
+// isFormBody reports whether req has a form body: oras-go's OAuth2 token request
+// sends username and password this way. The body is never read here.
+func isFormBody(req *http.Request) bool {
+	return req.Body != nil && req.Body != http.NoBody &&
+		strings.HasPrefix(strings.ToLower(req.Header.Get("Content-Type")), "application/x-www-form-urlencoded")
+}
+
+// checkDestination errors name only the method and host, never the credential,
+// the path, or the body.
+func (g *credentialGuard) checkDestination(req *http.Request) error {
+	host := strings.ToLower(req.URL.Host)
+	if g.ghcr != nil {
+		if g.allowedGHCR(req) {
+			return nil
+		}
+		return fmt.Errorf("refusing to send credentials to %s %s: GHCR credentials go only to the ghcr.io token endpoint and registry API and to the GitHub package-version API", req.Method, host)
+	}
+	if g.insecure {
+		if host == g.registry {
+			return nil
+		}
+		return fmt.Errorf("refusing to send credentials to %s %s: insecure mode sends them only to the registry host", req.Method, host)
+	}
+	if req.URL.Scheme == "https" {
+		return nil
+	}
+	return fmt.Errorf("refusing to send credentials to %s %s over plain HTTP", req.Method, host)
+}
+
+// allowedGHCR lists the GHCR destinations and the exact paths and methods that
+// may carry credentials. Anything else, including other paths on the same hosts,
+// is refused.
+func (g *credentialGuard) allowedGHCR(req *http.Request) bool {
+	u := req.URL
+	if u.Scheme != "https" {
+		return false
+	}
+	path := u.EscapedPath()
+	switch strings.ToLower(u.Host) {
+	case g.ghcr.tokenHost:
+		if path == "/token" {
+			// Basic-auth GET or OAuth2 form POST.
+			return (req.Method == http.MethodGet && req.Header.Get("Authorization") != "") ||
+				(req.Method == http.MethodPost && isFormBody(req))
+		}
+		return strings.HasPrefix(path, "/v2/") && !isFormBody(req) && req.Header.Get("Authorization") != ""
+	case g.ghcr.apiHost:
+		if req.Method == http.MethodGet {
+			return ghcrPackageVersionsPath.MatchString(path)
+		}
+		if req.Method == http.MethodDelete {
+			return ghcrPackageVersionPath.MatchString(path)
+		}
+	}
+	return false
+}
+
+type requestLimiter interface {
+	Wait(context.Context) error
+}
+
+type rateLimitedRoundTripper struct {
+	limiter requestLimiter
+	inner   http.RoundTripper
+}
+
+func (rt *rateLimitedRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	if rt.limiter != nil {
+		if err := rt.limiter.Wait(req.Context()); err != nil {
+			return nil, err
+		}
+	}
+	return rt.inner.RoundTrip(req)
+}
diff --git a/internal/backend/remote-state/oras/transport_test.go b/internal/backend/remote-state/oras/transport_test.go
new file mode 100644
index 000000000..bb3c438f1
--- /dev/null
+++ b/internal/backend/remote-state/oras/transport_test.go
@@ -0,0 +1,133 @@
+package oras
+
+import (
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+type recordingRoundTripper struct{ called bool }
+
+func (r *recordingRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	r.called = true
+	return &http.Response{StatusCode: http.StatusOK, Body: http.NoBody, Request: req}, nil
+}
+
+// newTestRequest builds a request with an optional Authorization header or form body.
+func newTestRequest(t *testing.T, method, target string, auth, form bool) *http.Request {
+	t.Helper()
+	var body io.Reader
+	if form {
+		body = strings.NewReader("grant_type=password&username=x&password=SECRET")
+	}
+	req, err := http.NewRequest(method, target, body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if form {
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	}
+	if auth {
+		req.Header.Set("Authorization", "Basic c2VjcmV0")
+	}
+	return req
+}
+
+func TestCredentialGuardMatrix(t *testing.T) {
+	ghcr := func() *credentialGuard {
+		return &credentialGuard{registry: "ghcr.io", ghcr: &ghcrEndpoints{tokenHost: "ghcr.io", apiHost: "api.github.com"}}
+	}
+	insecure := func(reg string) *credentialGuard { return &credentialGuard{registry: reg, insecure: true} }
+	secure := func() *credentialGuard { return &credentialGuard{registry: "registry.example.com"} }
+
+	tests := []struct {
+		name     string
+		guard    *credentialGuard
+		method   string
+		target   string
+		auth     bool
+		form     bool
+		wantSent bool
+	}{
+		{"GHCR basic GET token", ghcr(), "GET", "https://ghcr.io/token?service=ghcr.io", true, false, true},
+		{"GHCR OAuth2 form POST token", ghcr(), "POST", "https://ghcr.io/token", false, true, true},
+		{"GHCR registry request with bearer", ghcr(), "GET", "https://ghcr.io/v2/org/state/tags/list", true, false, true},
+		{"GHCR form POST to other path refused", ghcr(), "POST", "https://ghcr.io/evil-token", false, true, false},
+		{"GHCR basic GET to other path refused", ghcr(), "GET", "https://ghcr.io/evil-token", true, false, false},
+		{"GHCR form POST to attacker host refused", ghcr(), "POST", "https://evil.example/token", false, true, false},
+		{"GHCR basic to attacker host refused", ghcr(), "GET", "https://evil.example/token", true, false, false},
+		{"GHCR over plain HTTP refused", ghcr(), "GET", "http://ghcr.io/token", true, false, false},
+		{"GHCR anonymous request to other host allowed", ghcr(), "GET", "https://pkg-containers.example/blob", false, false, true},
+		{"GHCR package list via API", ghcr(), "GET", "https://api.github.com/orgs/o/packages/container/n/versions?per_page=100&page=1", true, false, true},
+		{"GHCR package version delete via API", ghcr(), "DELETE", "https://api.github.com/users/o/packages/container/n/versions/42", true, false, true},
+		{"GHCR package-name slash escaped", ghcr(), "GET", "https://api.github.com/orgs/o/packages/container/a%2Fb/versions", true, false, true},
+		{"GHCR API delete of the versions collection refused", ghcr(), "DELETE", "https://api.github.com/orgs/o/packages/container/n/versions", true, false, false},
+		{"GHCR API arbitrary repos path refused", ghcr(), "GET", "https://api.github.com/repos/o/n/actions/secrets", true, false, false},
+		{"GHCR API traversal refused", ghcr(), "DELETE", "https://api.github.com/orgs/o/packages/container/n/versions/42/../../../repos/o/n", true, false, false},
+		{"GHCR API POST refused", ghcr(), "POST", "https://api.github.com/orgs/o/packages/container/n/versions", true, false, false},
+		{"GHCR API form body refused", ghcr(), "POST", "https://api.github.com/orgs/o/packages/container/n/versions", false, true, false},
+		{"insecure basic to registry host", insecure("127.0.0.1:5000"), "GET", "http://127.0.0.1:5000/v2/", true, false, true},
+		{"insecure cross-host basic refused", insecure("127.0.0.1:5000"), "GET", "https://evil.example/token", true, false, false},
+		{"insecure cross-host form refused", insecure("127.0.0.1:5000"), "POST", "https://evil.example/token", false, true, false},
+		{"secure cross-host https form allowed (Docker-style realm)", secure(), "POST", "https://auth.example.net/token", false, true, true},
+		{"secure plain HTTP basic refused", secure(), "GET", "http://auth.example.net/token", true, false, false},
+		{"secure plain HTTP form refused", secure(), "POST", "http://auth.example.net/token", false, true, false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if _, err := url.Parse(tc.target); err != nil {
+				t.Fatal(err)
+			}
+			req := newTestRequest(t, tc.method, tc.target, tc.auth, tc.form)
+			inner := &recordingRoundTripper{}
+			tc.guard.inner = inner
+			resp, err := tc.guard.RoundTrip(req)
+			if tc.wantSent {
+				if err != nil || resp == nil || !inner.called {
+					t.Fatalf("request not sent: err=%v", err)
+				}
+				return
+			}
+			if err == nil || inner.called {
+				t.Fatalf("credentialed request was sent (err=%v)", err)
+			}
+		})
+	}
+}
+
+func TestCredentialGuardErrorDoesNotDiscloseCredential(t *testing.T) {
+	g := &credentialGuard{registry: "ghcr.io", ghcr: &ghcrEndpoints{tokenHost: "ghcr.io", apiHost: "api.github.com"}, inner: &recordingRoundTripper{}}
+	for _, form := range []bool{false, true} {
+		req := newTestRequest(t, "POST", "https://evil.example/token", !form, form)
+		_, err := g.RoundTrip(req)
+		if err == nil {
+			t.Fatal("expected refusal")
+		}
+		for _, leak := range []string{"c2VjcmV0", "SECRET", "grant_type", "password"} {
+			if strings.Contains(err.Error(), leak) {
+				t.Fatalf("error disclosed credential material %q: %v", leak, err)
+			}
+		}
+	}
+}
+
+func TestRejectInsecureGHCR(t *testing.T) {
+	tests := []struct {
+		registry string
+		insecure bool
+		wantErr  bool
+	}{
+		{"ghcr.io", true, true},
+		{"GHCR.IO", true, true},
+		{"ghcr.io", false, false},
+		{"127.0.0.1:5000", true, false},
+	}
+	for _, tc := range tests {
+		err := rejectInsecureGHCR(tc.registry, tc.insecure)
+		if (err != nil) != tc.wantErr {
+			t.Fatalf("rejectInsecureGHCR(%q, %v) = %v, wantErr %v", tc.registry, tc.insecure, err, tc.wantErr)
+		}
+	}
+}
