--- /dev/null
+++ b/internal/states/statemgr/history.go
@@ -0,0 +1,21 @@
+package statemgr
+
+import (
+	"context"
+	"time"
+)
+
+// StateVersion describes one retained historical state snapshot without
+// exposing backend-specific storage identifiers.
+type StateVersion struct {
+	Version   int       `json:"version"`
+	UpdatedAt time.Time `json:"updated_at,omitempty"`
+	Digest    string    `json:"digest,omitempty"`
+}
+
+// History is an optional read-only capability implemented by state managers
+// that can expose retained historical snapshots.
+type History interface {
+	ListVersions(context.Context) ([]StateVersion, error)
+	GetVersion(context.Context, int) ([]byte, error)
+}
