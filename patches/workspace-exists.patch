+package command
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/opentofu/opentofu/internal/backend"
+	backendInit "github.com/opentofu/opentofu/internal/backend/init"
+	"github.com/opentofu/opentofu/internal/command/workdir"
+	"github.com/opentofu/opentofu/internal/encryption"
+	"github.com/opentofu/opentofu/internal/states/statemgr"
+)
+
+// probeBackend adds the optional direct workspace lookup to MockBackend so the
+// tests can see whether a command probes one workspace or lists them all.
+type probeBackend struct {
+	*backendInit.MockBackend
+	existsFn    func(name string) bool
+	existsCalls []string
+}
+
+func (b *probeBackend) WorkspaceExists(_ context.Context, name string) (bool, error) {
+	b.existsCalls = append(b.existsCalls, name)
+	if b.existsFn != nil {
+		return b.existsFn(name), nil
+	}
+	return true, nil
+}
+
+// testWorkspaceExistenceBackend registers b under a temporary backend name
+// and points the working directory at a minimal configuration using it.
+func testWorkspaceExistenceBackend(t *testing.T, name string, b backend.Backend) Meta {
+	t.Helper()
+	td := t.TempDir()
+	if err := os.WriteFile(filepath.Join(td, "main.tf"), []byte(fmt.Sprintf("terraform {\n  backend %q {}\n}\n", name)), 0644); err != nil {
+		t.Fatal(err)
+	}
+	t.Chdir(td)
+
+	// init refreshes state through the backend, so give the mock a real
+	// filesystem-backed state manager.
+	var mock *backendInit.MockBackend
+	switch f := b.(type) {
+	case *backendInit.MockBackend:
+		mock = f
+	case *probeBackend:
+		mock = f.MockBackend
+	}
+	t.Cleanup(backendInit.RegisterTemp(name, func(enc encryption.StateEncryption) backend.Backend {
+		if mock != nil && mock.StateMgrFn == nil {
+			mock.StateMgrFn = func(workspace string) (statemgr.Full, error) {
+				return statemgr.NewFilesystem(filepath.Join(td, "state", workspace), enc), nil
+			}
+		}
+		return b
+	}))
+
+	return Meta{
+		WorkingDir:       workdir.NewDir("."),
+		testingOverrides: metaOverridesForProvider(testProvider()),
+	}
+}
+
+// When the backend offers a direct lookup, `workspace select` must use it and
+// never fall back to listing every workspace.
+func TestWorkspaceSelect_UsesDirectLookup(t *testing.T) {
+	fake := &probeBackend{MockBackend: &backendInit.MockBackend{
+		WorkspacesFn: func() ([]string, error) {
+			return []string{backend.DefaultStateName}, nil
+		},
+	}}
+	meta := testWorkspaceExistenceBackend(t, "_exists_direct", fake)
+
+	view, done := testView(t)
+	meta.View = view
+	code := RunCommander(t, InitCommander(), meta, []string{"-input=false"})
+	out := done(t)
+	if code != 0 {
+		t.Fatalf("init failed with code %d: %s", code, out.Stderr())
+	}
+	if fake.MockBackend.WorkspacesCalled {
+		t.Fatal("init listed workspaces even though the backend supports a direct lookup")
+	}
+
+	view, done = testView(t)
+	meta.View = view
+	code = RunCommander(t, WorkspaceSelectCommander(false), meta, []string{"prod"})
+	out = done(t)
+	if code != 0 {
+		t.Fatalf("select failed with code %d: %s", code, out.Stderr())
+	}
+	if fake.MockBackend.WorkspacesCalled {
+		t.Fatal("workspace select listed workspaces even though the backend supports a direct lookup")
+	}
+	probed := false
+	for _, name := range fake.existsCalls {
+		if name == "prod" {
+			probed = true
+		}
+	}
+	if !probed {
+		t.Fatalf("direct lookup never checked workspace %q; calls: %v", "prod", fake.existsCalls)
+	}
+}
+
+// A backend without the optional lookup keeps the listing behavior.
+func TestWorkspaceSelect_FallsBackToListing(t *testing.T) {
+	fake := &backendInit.MockBackend{
+		WorkspacesFn: func() ([]string, error) {
+			return []string{backend.DefaultStateName, "prod"}, nil
+		},
+	}
+	meta := testWorkspaceExistenceBackend(t, "_exists_list", fake)
+
+	view, done := testView(t)
+	meta.View = view
+	code := RunCommander(t, InitCommander(), meta, []string{"-input=false"})
+	out := done(t)
+	if code != 0 {
+		t.Fatalf("init failed with code %d: %s", code, out.Stderr())
+	}
+	if !fake.WorkspacesCalled {
+		t.Fatal("init did not list workspaces even though the backend has no direct lookup")
+	}
+
+	fake.WorkspacesCalled = false
+	view, done = testView(t)
+	meta.View = view
+	code = RunCommander(t, WorkspaceSelectCommander(false), meta, []string{"prod"})
+	out = done(t)
+	if code != 0 {
+		t.Fatalf("select failed with code %d: %s", code, out.Stderr())
+	}
+	if !fake.WorkspacesCalled {
+		t.Fatal("workspace select did not list workspaces even though the backend has no direct lookup")
+	}
+}
+
+// An unknown current selection during init must still list the workspaces and
+// report the absence, exactly as before.
+func TestInit_UnknownSelectionStillLists(t *testing.T) {
+	fake := &probeBackend{
+		MockBackend: &backendInit.MockBackend{
+			WorkspacesFn: func() ([]string, error) {
+				return []string{backend.DefaultStateName, "prod"}, nil
+			},
+		},
+		existsFn: func(string) bool { return false },
+	}
+	t.Setenv("TF_WORKSPACE", "ghost")
+	meta := testWorkspaceExistenceBackend(t, "_exists_ghost", fake)
+
+	view, done := testView(t)
+	meta.View = view
+	code := RunCommander(t, InitCommander(), meta, []string{"-input=false"})
+	out := done(t)
+	if code == 0 {
+		t.Fatal("init succeeded even though the selected workspace does not exist")
+	}
+	if !fake.MockBackend.WorkspacesCalled {
+		t.Fatal("init did not list workspaces for the absent selection")
+	}
+	probed := false
+	for _, name := range fake.existsCalls {
+		if name == "ghost" {
+			probed = true
+		}
+	}
+	if !probed {
+		t.Fatalf("direct lookup never checked workspace %q; calls: %v", "ghost", fake.existsCalls)
+	}
+	if !strings.Contains(out.Stderr(), `Currently selected workspace "ghost" does not exist`) {
+		t.Fatalf("unexpected diagnostics: %s", out.Stderr())
+	}
+}
