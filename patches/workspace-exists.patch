+	// A backend that can check a single workspace directly lets us skip the
+	// listing entirely when the current selection exists.
+	if checker, ok := b.(backend.WorkspaceExistence); ok {
+		workspace, err := m.Workspace(ctx)
+		if err != nil {
+			return err
+		}
+		if exists, err := checker.WorkspaceExists(ctx, workspace); err == nil && exists {
+			log.Printf("[TRACE] Meta.selectWorkspace: the currently selected workspace is present in the configured backend (%s)", workspace)
