+// WorkspaceExists reports whether a workspace with the given name exists via
+// the client's direct lookup; callers fall back to listing if it fails.
+func (b *Backend) WorkspaceExists(ctx context.Context, name string) (bool, error) {
+	if b.client == nil {
+		return false, fmt.Errorf("backend is not configured")
+	}
+	if name == backend.DefaultStateName {
+		// Workspaces always synthesizes the default workspace, so the direct
+		// lookup must agree even when the registry layout has no default
+		// marker; otherwise init/select would treat it as absent.
+		return true, nil
+	}
+	return b.client.WorkspaceExists(ctx, name)
+}
