+// WorkspaceExistence is an optional interface a Backend may implement to
+// check for a single workspace without listing them all.
+type WorkspaceExistence interface {
+	// WorkspaceExists reports whether a workspace with the given name exists
+	// in the backend.
+	WorkspaceExists(ctx context.Context, name string) (bool, error)
+}
+
+// WorkspaceExists reports whether a workspace with the given name exists in
+// b. It uses the backend's direct per-workspace lookup when b implements
+// [WorkspaceExistence] and that lookup succeeds, and falls back to listing
+// all workspaces otherwise.
+func WorkspaceExists(ctx context.Context, b Backend, name string) (bool, error) {
+	if checker, ok := b.(WorkspaceExistence); ok {
+		if exists, err := checker.WorkspaceExists(ctx, name); err == nil {
+			return exists, nil
+		}
+		// A failed direct lookup behaves like the listing below.
+	}
+	workspaces, err := b.Workspaces(ctx)
+	if err != nil {
+		return false, err
+	}
+	return slices.Contains(workspaces, name), nil
+}
