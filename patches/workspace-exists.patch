+package oras
+
+import (
+	"context"
+	"testing"
+
+	orasstate "github.com/vmvarela/oras-state"
+
+	"github.com/opentofu/opentofu/internal/backend"
+)
+
+var _ backend.WorkspaceExistence = (*Backend)(nil)
+
+// Compile-time proof that the pinned oras-state client provides the direct
+// lookup Backend.WorkspaceExists calls.
+var _ interface {
+	WorkspaceExists(context.Context, string) (bool, error)
+} = (*orasstate.Client)(nil)
+
+// An unconfigured backend must fail the check instead of pretending the
+// workspace is absent.
+func TestWorkspaceExists_UnconfiguredBackend(t *testing.T) {
+	b := &Backend{}
+	exists, err := b.WorkspaceExists(t.Context(), "default")
+	if err == nil {
+		t.Fatalf("expected an error from an unconfigured backend, got exists=%v", exists)
+	}
+}
+
+// Workspaces always appends the default workspace, so the direct lookup must
+// report it as existing without consulting the registry layout (a per-name
+// prober mirroring List would say false once other named workspaces exist).
+func TestWorkspaceExists_DefaultIsSynthetic(t *testing.T) {
+	b := &Backend{client: &orasstate.Client{}}
+	exists, err := b.WorkspaceExists(t.Context(), backend.DefaultStateName)
+	if err != nil {
+		t.Fatalf("checking the default workspace failed: %v", err)
+	}
+	if !exists {
+		t.Fatal("default workspace must be reported as existing")
+	}
+}
